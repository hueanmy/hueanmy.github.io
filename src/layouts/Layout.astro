---
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Meii — developer building tools, extensions, and open source.',
} = Astro.props;
---

<!doctype html>
<html lang="en" data-theme="light">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
    {/* FOUC prevention — set theme attribute BEFORE first paint.
        Default is light; users can opt into dark via the toggle (persists in localStorage). */}
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('theme');
          const theme = stored || 'light';
          document.documentElement.setAttribute('data-theme', theme);
        } catch (e) {
          /* localStorage blocked / SSR — leave default light */
        }
      })();
    </script>
  </head>
  <body>
    <ThemeToggle />
    <slot />

    <dialog id="video-lightbox" aria-label="Video preview">
      <button class="lightbox-close" type="button" aria-label="Close">×</button>
      <video controls playsinline preload="metadata"></video>
    </dialog>

    <style is:global>
      #video-lightbox {
        max-width: min(92vw, 1200px);
        max-height: 90vh;
        width: 100%;
        padding: 0;
        background: #000;
        border: 1px solid var(--border);
        border-radius: 10px;
        overflow: hidden;
      }
      #video-lightbox::backdrop {
        background: rgba(0, 0, 0, 0.78);
        backdrop-filter: blur(4px);
      }
      #video-lightbox video {
        width: 100%;
        height: 100%;
        max-height: 90vh;
        display: block;
        background: #000;
      }
      #video-lightbox .lightbox-close {
        position: absolute;
        top: 0.5rem;
        right: 0.5rem;
        width: 36px;
        height: 36px;
        border-radius: 50%;
        background: rgba(7, 9, 14, 0.85);
        color: #fff;
        border: 1px solid rgba(255, 255, 255, 0.15);
        font-size: 1.4rem;
        line-height: 1;
        cursor: pointer;
        z-index: 1;
      }
      #video-lightbox .lightbox-close:hover {
        background: rgba(7, 9, 14, 1);
      }
    </style>

    <script is:inline>
      (() => {
        const dlg = document.getElementById('video-lightbox');
        if (!dlg) return;
        const dlgVideo = dlg.querySelector('video');
        const closeBtn = dlg.querySelector('.lightbox-close');

        const close = () => {
          dlgVideo.pause();
          dlgVideo.removeAttribute('src');
          dlgVideo.load();
          if (dlg.open) dlg.close();
        };

        document.addEventListener('click', (e) => {
          const card = e.target.closest('.card[data-video]');
          if (!card) return;
          const trigger = e.target.closest('.video');
          if (!trigger) return;
          e.preventDefault();
          const src = card.getAttribute('data-video');
          if (!src) return;
          dlgVideo.src = src;
          dlg.showModal();
          dlgVideo.play().catch(() => {});
        });

        closeBtn.addEventListener('click', close);
        dlg.addEventListener('close', close);
        dlg.addEventListener('click', (e) => {
          if (e.target === dlg) close();
        });
      })();
    </script>
  </body>
</html>
