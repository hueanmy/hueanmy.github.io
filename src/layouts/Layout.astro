---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Meii — developer building AI tools and open source.',
} = Astro.props;

const tabs = [
  { id: 'writing',   label: 'Writing' },
  { id: 'resources', label: 'Free Resources' },
  { id: 'projects',  label: 'Projects' },
  { id: 'about',     label: 'About Me' },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=DM+Serif+Display&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-header-wrap">
    <header class="site-header">
      <a href="/" class="site-logo">Meii</a>
      <nav class="site-nav" role="tablist">
        {tabs.map((tab, i) => (
          <button
            class={`nav-btn${i === 0 ? ' active' : ''}`}
            data-tab={tab.id}
            role="tab"
            aria-selected={i === 0 ? 'true' : 'false'}
          >
            {tab.label}
          </button>
        ))}
      </nav>
    </header>
    </div>

    <main class="site-main">
      <slot />
    </main>

    <dialog id="video-lightbox" aria-label="Video preview">
      <button class="lightbox-close" type="button" aria-label="Close">×</button>
      <video controls playsinline preload="metadata"></video>
    </dialog>

    <style is:global>
      #video-lightbox {
        max-width: min(92vw, 1200px);
        max-height: 90vh;
        width: 100%;
        padding: 0;
        background: #000;
        border: none;
        border-radius: 8px;
        overflow: hidden;
      }
      #video-lightbox::backdrop {
        background: rgba(0,0,0,0.7);
      }
      #video-lightbox video {
        width: 100%; height: 100%; max-height: 90vh; display: block;
      }
      #video-lightbox .lightbox-close {
        position: absolute; top: 0.5rem; right: 0.5rem;
        width: 32px; height: 32px; border-radius: 50%;
        background: rgba(0,0,0,0.7); color: #fff; border: none;
        font-size: 1.2rem; cursor: pointer; z-index: 1;
      }
    </style>

    <script is:inline>
      (() => {
        const btns   = document.querySelectorAll('.nav-btn');
        const panels = document.querySelectorAll('.tab-panel');

        function activate(id) {
          btns.forEach(b => {
            const on = b.dataset.tab === id;
            b.classList.toggle('active', on);
            b.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          panels.forEach(p => { p.hidden = p.dataset.panel !== id; });
        }

        btns.forEach(b => b.addEventListener('click', () => activate(b.dataset.tab)));

        const dlg = document.getElementById('video-lightbox');
        if (dlg) {
          const vid = dlg.querySelector('video');
          const close = () => { vid.pause(); vid.src = ''; if (dlg.open) dlg.close(); };
          document.addEventListener('click', e => {
            const card = e.target.closest('.card[data-video]');
            if (!card || !e.target.closest('.video')) return;
            e.preventDefault();
            vid.src = card.dataset.video;
            dlg.showModal();
            vid.play().catch(() => {});
          });
          dlg.querySelector('.lightbox-close').addEventListener('click', close);
          dlg.addEventListener('close', close);
          dlg.addEventListener('click', e => { if (e.target === dlg) close(); });
        }
      })();
    </script>
  </body>
</html>
