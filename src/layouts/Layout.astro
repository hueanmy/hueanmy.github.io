---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Meii — developer building AI tools and open source.',
} = Astro.props;

const tabs = [
  { id: 'writing',   en: 'Writing',        vi: 'Bài viết' },
  { id: 'builds',    en: 'Build Logs',      vi: 'Nhật ký build' },
  { id: 'resources', en: 'Free Resources',  vi: 'Tài nguyên' },
  { id: 'projects',  en: 'Projects',        vi: 'Dự án' },
  { id: 'about',     en: 'About Me',        vi: 'Về mình' },
];
---

<!doctype html>
<html lang="en" data-lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Fraunces:opsz,wght@9..144,400;9..144,500;9..144,600;9..144,700&family=Inter:wght@400;500;600&family=JetBrains+Mono:wght@400;500&display=swap"
    />
    <title>{title}</title>
  </head>
  <body>
    <div class="site-header-wrap">
      <header class="site-header">
        <a href="/" class="site-logo">Meii</a>
        <nav class="site-nav" role="tablist">
          {tabs.map((tab, i) => (
            <button
              class={`nav-btn${i === 0 ? ' active' : ''}`}
              data-tab={tab.id}
              role="tab"
              aria-selected={i === 0 ? 'true' : 'false'}
            >
              <span class="lang-en">{tab.en}</span>
              <span class="lang-vi">{tab.vi}</span>
            </button>
          ))}
        </nav>
        <a
          href="https://github.com/hueanmy"
          class="github-link"
          target="_blank"
          rel="noopener"
          aria-label="GitHub"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
            <path d="M12 0C5.37 0 0 5.37 0 12c0 5.3 3.438 9.8 8.205 11.385.6.113.82-.258.82-.577 0-.285-.01-1.04-.015-2.04-3.338.724-4.042-1.61-4.042-1.61C4.422 17.07 3.633 16.7 3.633 16.7c-1.087-.744.084-.729.084-.729 1.205.084 1.838 1.236 1.838 1.236 1.07 1.835 2.809 1.305 3.495.998.108-.776.417-1.305.76-1.605-2.665-.3-5.466-1.332-5.466-5.93 0-1.31.465-2.38 1.235-3.22-.135-.303-.54-1.523.105-3.176 0 0 1.005-.322 3.3 1.23.96-.267 1.98-.399 3-.405 1.02.006 2.04.138 3 .405 2.28-1.552 3.285-1.23 3.285-1.23.645 1.653.24 2.873.12 3.176.765.84 1.23 1.91 1.23 3.22 0 4.61-2.805 5.625-5.475 5.92.42.36.81 1.096.81 2.22 0 1.606-.015 2.896-.015 3.286 0 .315.21.69.825.57C20.565 21.795 24 17.295 24 12c0-6.63-5.37-12-12-12"/>
          </svg>
        </a>
        <button id="lang-toggle" class="lang-toggle" aria-label="Switch language">VI</button>
      </header>
    </div>

    <main class="site-main">
      <slot />
    </main>

    <dialog id="video-lightbox" aria-label="Video preview">
      <button class="lightbox-close" type="button" aria-label="Close">&times;</button>
      <video controls playsinline preload="metadata"></video>
    </dialog>

    <style is:global>
      /* i18n visibility */
      [data-lang=en] .lang-vi { display: none !important; }
      [data-lang=vi] .lang-en { display: none !important; }

      #video-lightbox {
        max-width: min(92vw, 1200px);
        max-height: 90vh;
        width: 100%;
        padding: 0;
        background: #000;
        border: none;
        border-radius: 8px;
        overflow: hidden;
      }
      #video-lightbox::backdrop { background: rgba(0,0,0,0.7); }
      #video-lightbox video { width: 100%; height: 100%; max-height: 90vh; display: block; }
      #video-lightbox .lightbox-close {
        position: absolute; top: 0.5rem; right: 0.5rem;
        width: 32px; height: 32px; border-radius: 50%;
        background: rgba(0,0,0,0.7); color: #fff; border: none;
        font-size: 1.2rem; cursor: pointer; z-index: 1;
      }

      .lang-toggle {
        font-family: var(--font-mono);
        font-size: 0.68rem;
        font-weight: 600;
        letter-spacing: 0.08em;
        padding: 0.3rem 0.65rem;
        background: none;
        border: 1px solid var(--border);
        border-radius: 4px;
        color: var(--fg-muted);
        cursor: pointer;
        transition: border-color 120ms, color 120ms;
        flex-shrink: 0;
        margin-left: 0.5rem;
      }
      .lang-toggle:hover { border-color: var(--accent); color: var(--accent); }

      .github-link {
        display: flex;
        align-items: center;
        color: var(--fg-muted);
        margin-left: 0.5rem;
        transition: color 120ms;
      }
      .github-link:hover { color: var(--fg); }
    </style>

    <script is:inline>
      (() => {
        const html    = document.documentElement;
        const toggle  = document.getElementById('lang-toggle');
        const btns    = document.querySelectorAll('.nav-btn');
        const panels  = document.querySelectorAll('.tab-panel');
        const search  = document.getElementById('writing-search');

        /* restore saved lang */
        const saved = localStorage.getItem('lang') || 'en';
        html.dataset.lang = saved;
        if (toggle) toggle.textContent = saved === 'en' ? 'VI' : 'EN';

        /* update search placeholder */
        function updatePlaceholder() {
          if (!search) return;
          search.placeholder = html.dataset.lang === 'vi' ? 'Tìm kiếm...' : 'Search...';
        }
        updatePlaceholder();

        /* lang toggle */
        if (toggle) {
          toggle.addEventListener('click', () => {
            const next = html.dataset.lang === 'en' ? 'vi' : 'en';
            html.dataset.lang = next;
            localStorage.setItem('lang', next);
            toggle.textContent = next === 'en' ? 'VI' : 'EN';
            updatePlaceholder();
          });
        }

        /* tab navigation */
        function activate(id) {
          btns.forEach(b => {
            const on = b.dataset.tab === id;
            b.classList.toggle('active', on);
            b.setAttribute('aria-selected', on ? 'true' : 'false');
          });
          panels.forEach(p => { p.hidden = p.dataset.panel !== id; });
        }
        btns.forEach(b => b.addEventListener('click', () => activate(b.dataset.tab)));

        /* video lightbox */
        const dlg = document.getElementById('video-lightbox');
        if (dlg) {
          const vid = dlg.querySelector('video');
          const close = () => { vid.pause(); vid.src = ''; if (dlg.open) dlg.close(); };
          document.addEventListener('click', e => {
            const card = e.target.closest('.card[data-video]');
            if (!card || !e.target.closest('.video')) return;
            e.preventDefault();
            vid.src = card.dataset.video;
            dlg.showModal();
            vid.play().catch(() => {});
          });
          dlg.querySelector('.lightbox-close').addEventListener('click', close);
          dlg.addEventListener('close', close);
          dlg.addEventListener('click', e => { if (e.target === dlg) close(); });
        }
      })();
    </script>
  </body>
</html>
