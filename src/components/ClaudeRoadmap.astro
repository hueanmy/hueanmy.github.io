---
const phases = [
  { num: '01', label: 'Foundation', title: 'Understand Claude' },
  { num: '02', label: 'Prompting', title: 'Prompt Engineering' },
  { num: '03', label: 'API', title: 'Anthropic API Integration' },
  { num: '04', label: 'Agents', title: 'Tool Use & Agents' },
  { num: '05', label: 'CLI', title: 'Claude Code CLI' },
  { num: '06', label: 'MCP', title: 'Model Context Protocol' },
  { num: '07', label: 'Scale', title: 'Production & Scale' },
];
---

<section id="claude-roadmap" class="roadmap-section">
  <div class="section-head">
    <h2>Claude Dev Roadmap</h2>
    <div class="head-actions">
      <a class="head-link" href="https://github.com/hueanmy/claude-roadmap" target="_blank" rel="noopener">Working examples on GitHub ↗</a>
      <a class="head-link" href="/claude-roadmap.html" target="_blank" rel="noopener">Open full version ↗</a>
    </div>
  </div>

  <a class="rm-card" href="/claude-roadmap.html" target="_blank" rel="noopener">
    <div class="rm-head">
      <span class="rm-badge">
        <span class="lang-en">Developer Roadmap</span>
        <span class="lang-vi">Lộ trình Developer</span>
      </span>
      <h3 class="rm-title">Working with Claude</h3>
      <p class="rm-tagline">
        <span class="lang-en">From zero to production — everything a developer needs to know when working with Claude. 7 phases, from foundation to production scale.</span>
        <span class="lang-vi">Từ zero đến production — mọi thứ một developer cần biết khi làm việc với Claude. 7 phases, từ foundation tới production scale.</span>
      </p>
    </div>

    <ol class="phases">
      {phases.map((p) => (
        <li class="phase">
          <span class="phase-num">{p.num}</span>
          <span class="phase-label">{p.label}</span>
          <span class="phase-title">{p.title}</span>
        </li>
      ))}
    </ol>

    <div class="rm-cta">
      <span class="lang-en">→ View full roadmap</span>
      <span class="lang-vi">→ Xem roadmap đầy đủ</span>
    </div>
  </a>
</section>

<style>
  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.25rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--border);
  }
  .section-head h2 {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-muted);
    margin: 0;
  }
  .head-actions { display: flex; gap: 1.25rem; flex-wrap: wrap; justify-content: flex-end; }
  .head-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    transition: color 120ms;
  }
  .head-link:hover { color: var(--accent-hover); text-decoration: underline; text-underline-offset: 3px; }

  .rm-card {
    display: block;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 1.25rem;
    color: inherit;
    transition: box-shadow 150ms ease;
  }
  .rm-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.07); }

  .rm-head { margin-bottom: 1rem; }

  .rm-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 2px 8px;
    border-radius: 20px;
    margin-bottom: 0.6rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .rm-title {
    font-family: var(--font-serif);
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--fg);
    line-height: 1.2;
    margin-bottom: 0.35rem;
  }

  .rm-tagline {
    font-size: 0.82rem;
    color: var(--fg-dim);
    line-height: 1.55;
  }

  .phases {
    list-style: none;
    padding: 0;
    margin: 0 0 0.85rem;
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 0.3rem 0.5rem;
  }

  .phase {
    display: grid;
    grid-template-columns: auto auto 1fr;
    align-items: center;
    gap: 0.5rem;
    padding: 0.3rem 0.55rem;
    border: 1px solid var(--border);
    border-left: 2px solid var(--accent);
    border-radius: 6px;
    font-size: 0.75rem;
    transition: background 150ms;
  }
  .phase:hover { background: var(--accent-soft); }

  .phase-num {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    color: var(--fg-muted);
  }

  .phase-label {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    font-weight: 600;
    color: var(--accent);
  }

  .phase-title {
    font-size: 0.74rem;
    color: var(--fg);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  .rm-cta {
    text-align: right;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--accent);
    transition: color 120ms;
  }
  .rm-card:hover .rm-cta { color: var(--accent-hover); }

  @media (max-width: 720px) { .phases { grid-template-columns: 1fr; } }
  @media (max-width: 520px) {
    .section-head { flex-direction: column; gap: 0.5rem; }
    .head-actions { justify-content: flex-start; }
    .phase { grid-template-columns: auto 1fr; }
    .phase-title { grid-column: 1 / -1; white-space: normal; color: var(--fg-dim); }
  }
</style>
