---
---

<section id="claude-roadmap" class="roadmap-section">
  <div class="section-head">
    <h2>Claude Dev Roadmap</h2>
    <a class="open-full" href="/claude-roadmap.html" target="_blank" rel="noopener">
      Open full version ↗
    </a>
  </div>

  <div class="roadmap-header">
    <div class="header-badge">Developer Roadmap</div>
    <h3 class="roadmap-title">Working with Claude</h3>
    <p class="roadmap-tagline">
      Từ zero đến production — mọi thứ một developer cần biết khi làm việc với
      Claude
    </p>
  </div>

  <div class="roadmap">
    <div class="rm-section">
      <div class="phase-label">Phase 1 — Foundation</div>
      <div class="main-node cyan">🧠 Understand Claude</div>
      <div class="sub-row">
        <span class="sub-node highlight-cyan">How LLMs work</span>
        <span class="sub-node highlight-cyan">Claude vs GPT vs Gemini</span>
        <span class="sub-node highlight-cyan">Context window</span>
        <span class="sub-node highlight-cyan">Token & pricing</span>
        <span class="sub-node highlight-cyan">Opus / Sonnet / Haiku</span>
        <span class="sub-node highlight-cyan">Claude.ai vs API</span>
      </div>
    </div>

    <div class="connector"></div>

    <div class="rm-section">
      <div class="phase-label">Phase 2 — Prompting</div>
      <div class="main-node purple">✍️ Prompt Engineering</div>
      <div class="sub-row">
        <span class="sub-node highlight-purple">System prompt</span>
        <span class="sub-node highlight-purple">Role & persona</span>
        <span class="sub-node highlight-purple">Few-shot examples</span>
        <span class="sub-node highlight-purple">Chain of thought</span>
        <span class="sub-node highlight-purple">XML tags</span>
        <span class="sub-node highlight-purple">Output format control</span>
        <span class="sub-node highlight-purple">Temperature & top_p</span>
        <span class="sub-node highlight-purple">Prompt caching</span>
      </div>
    </div>

    <div class="connector"></div>

    <div class="rm-section">
      <div class="phase-label">Phase 3 — API Integration</div>
      <div class="main-node yellow">⚡ Anthropic API</div>
      <div class="sub-row">
        <span class="sub-node highlight-yellow">SDK (Python / JS)</span>
        <span class="sub-node highlight-yellow">Messages API</span>
        <span class="sub-node highlight-yellow">Streaming</span>
        <span class="sub-node highlight-yellow">Batch API</span>
        <span class="sub-node highlight-yellow">Vision / Multimodal</span>
        <span class="sub-node highlight-yellow">PDF & documents</span>
        <span class="sub-node highlight-yellow">Rate limits</span>
        <span class="sub-node highlight-yellow">Error handling</span>
      </div>
    </div>

    <div class="connector"></div>

    <div class="rm-section">
      <div class="phase-label">Phase 4 — Tools & Agents</div>
      <div class="main-node green">🔧 Tool Use & Agents</div>
      <div class="sub-row">
        <span class="sub-node highlight-green">Tool / Function calling</span>
        <span class="sub-node highlight-green">Tool schemas (JSON)</span>
        <span class="sub-node highlight-green">Multi-tool orchestration</span>
        <span class="sub-node highlight-green">Agentic loop</span>
        <span class="sub-node highlight-green">Computer use</span>
        <span class="sub-node highlight-green">Web search tool</span>
        <span class="sub-node highlight-green">Human-in-the-loop</span>
      </div>
    </div>

    <div class="connector"></div>

    <div class="rm-section">
      <div class="phase-label">Phase 5 — Claude Code</div>
      <div class="main-node cyan">💻 Claude Code CLI</div>
      <div class="section-with-sides">
        <div class="side-panel">
          <h4>Commands</h4>
          <ul>
            <li>/help</li>
            <li>/plan</li>
            <li>/clear</li>
            <li>/compact</li>
            <li>/memory</li>
            <li>/cost</li>
            <li>/doctor</li>
          </ul>
        </div>
        <div class="center-col">
          <div class="sub-row no-pad-top">
            <span class="sub-node highlight-cyan">CLAUDE.md</span>
            <span class="sub-node highlight-cyan">Skills</span>
            <span class="sub-node highlight-cyan">Subagents</span>
            <span class="sub-node highlight-cyan">Hooks</span>
            <span class="sub-node highlight-cyan">MCP integration</span>
            <span class="sub-node highlight-cyan">Slash commands</span>
            <span class="sub-node highlight-cyan">Permission modes</span>
            <span class="sub-node highlight-cyan">Plan mode</span>
            <span class="sub-node highlight-cyan">Headless mode</span>
            <span class="sub-node highlight-cyan">Git worktrees</span>
          </div>
        </div>
        <div class="side-panel">
          <h4>Shortcuts</h4>
          <ul>
            <li>Ctrl+C</li>
            <li>Ctrl+R</li>
            <li>Shift+Tab</li>
            <li>Esc + Esc</li>
            <li>@ mention</li>
            <li>\ multiline</li>
          </ul>
        </div>
      </div>
    </div>

    <div class="connector"></div>

    <div class="rm-section">
      <div class="phase-label">Phase 6 — MCP</div>
      <div class="main-node purple">🔌 Model Context Protocol</div>
      <div class="sub-row">
        <span class="sub-node highlight-purple">MCP architecture</span>
        <span class="sub-node highlight-purple">MCP servers</span>
        <span class="sub-node highlight-purple">MCP clients</span>
        <span class="sub-node highlight-purple">Build custom MCP</span>
        <span class="sub-node highlight-purple">MCP + Claude Code</span>
        <span class="sub-node highlight-purple">Stdio vs SSE transport</span>
        <span class="sub-node highlight-purple">Auth & security</span>
      </div>
    </div>

    <div class="connector"></div>

    <div class="rm-section">
      <div class="phase-label">Phase 7 — Advanced</div>
      <div class="main-node pink">🚀 Production & Scale</div>
      <div class="sub-row">
        <span class="sub-node highlight-pink">Agent Teams</span>
        <span class="sub-node highlight-pink">Multi-agent orchestration</span>
        <span class="sub-node highlight-pink">Evals & testing</span>
        <span class="sub-node highlight-pink">Fine-tuning strategy</span>
        <span class="sub-node highlight-pink">Cost optimization</span>
        <span class="sub-node highlight-pink">Security best practices</span>
        <span class="sub-node highlight-pink">Observability & logging</span>
        <span class="sub-node highlight-pink">CI/CD integration</span>
      </div>
    </div>

    <div class="legend">
      <div class="legend-item">
        <div class="legend-dot dot-cyan"></div>
        Core / Claude Code
      </div>
      <div class="legend-item">
        <div class="legend-dot dot-purple"></div>
        Prompting / MCP
      </div>
      <div class="legend-item">
        <div class="legend-dot dot-yellow"></div>
        API
      </div>
      <div class="legend-item">
        <div class="legend-dot dot-green"></div>
        Tools & Agents
      </div>
      <div class="legend-item">
        <div class="legend-dot dot-pink"></div>
        Production
      </div>
    </div>
  </div>
</section>

<style>
  .roadmap-section {
    --rm-cyan: #00d4d4;
    --rm-purple: #a855f7;
    --rm-pink: #f472b6;
    --rm-yellow: #fbbf24;
    --rm-green: #34d399;
    --rm-surface: #13131a;
    --rm-border: #1e1e2e;
    --rm-muted: #64748b;
  }

  .section-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.5rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .section-head h2 {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-dim);
    margin: 0;
    padding: 0;
    border: 0;
  }

  .open-full {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--rm-cyan);
    white-space: nowrap;
    transition: color 150ms ease;
  }

  .open-full:hover {
    color: var(--rm-purple);
  }

  .roadmap-header {
    text-align: center;
    margin-bottom: 3rem;
  }

  .header-badge {
    display: inline-block;
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--rm-cyan);
    border: 1px solid var(--rm-cyan);
    padding: 4px 12px;
    border-radius: 20px;
    margin-bottom: 1rem;
    letter-spacing: 2px;
    text-transform: uppercase;
  }

  .roadmap-title {
    font-size: clamp(2rem, 5vw, 3rem);
    font-weight: 800;
    line-height: 1.1;
    background: linear-gradient(
      135deg,
      var(--rm-cyan) 0%,
      var(--rm-purple) 50%,
      var(--rm-pink) 100%
    );
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.75rem;
  }

  .roadmap-tagline {
    color: var(--rm-muted);
    font-size: 1rem;
    font-weight: 300;
  }

  .roadmap {
    display: flex;
    flex-direction: column;
    align-items: center;
    gap: 0;
  }

  .rm-section {
    width: 100%;
    display: flex;
    flex-direction: column;
    align-items: center;
  }

  .main-node {
    position: relative;
    z-index: 2;
    padding: 14px 32px;
    border-radius: 8px;
    font-weight: 700;
    font-size: 1rem;
    letter-spacing: 0.5px;
    transition:
      transform 0.2s,
      box-shadow 0.2s;
    white-space: nowrap;
  }

  .main-node:hover {
    transform: scale(1.04);
  }

  .main-node.cyan {
    background: linear-gradient(135deg, #003333, #004444);
    border: 2px solid var(--rm-cyan);
    color: var(--rm-cyan);
    box-shadow: 0 0 20px rgba(0, 212, 212, 0.2);
  }
  .main-node.cyan:hover {
    box-shadow: 0 0 30px rgba(0, 212, 212, 0.4);
  }

  .main-node.purple {
    background: linear-gradient(135deg, #1a0033, #220044);
    border: 2px solid var(--rm-purple);
    color: var(--rm-purple);
    box-shadow: 0 0 20px rgba(168, 85, 247, 0.2);
  }
  .main-node.purple:hover {
    box-shadow: 0 0 30px rgba(168, 85, 247, 0.4);
  }

  .main-node.yellow {
    background: linear-gradient(135deg, #1a1200, #221800);
    border: 2px solid var(--rm-yellow);
    color: var(--rm-yellow);
    box-shadow: 0 0 20px rgba(251, 191, 36, 0.2);
  }
  .main-node.yellow:hover {
    box-shadow: 0 0 30px rgba(251, 191, 36, 0.4);
  }

  .main-node.green {
    background: linear-gradient(135deg, #001a12, #002218);
    border: 2px solid var(--rm-green);
    color: var(--rm-green);
    box-shadow: 0 0 20px rgba(52, 211, 153, 0.2);
  }
  .main-node.green:hover {
    box-shadow: 0 0 30px rgba(52, 211, 153, 0.4);
  }

  .main-node.pink {
    background: linear-gradient(135deg, #1a0011, #220018);
    border: 2px solid var(--rm-pink);
    color: var(--rm-pink);
    box-shadow: 0 0 20px rgba(244, 114, 182, 0.2);
  }
  .main-node.pink:hover {
    box-shadow: 0 0 30px rgba(244, 114, 182, 0.4);
  }

  .connector {
    width: 2px;
    height: 40px;
    background: linear-gradient(to bottom, var(--rm-border), var(--rm-muted));
    position: relative;
    z-index: 1;
  }

  .connector::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    width: 8px;
    height: 8px;
    background: var(--rm-muted);
    border-radius: 50%;
  }

  .sub-row {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 10px;
    padding: 20px 0;
    position: relative;
    max-width: 800px;
    width: 100%;
  }

  .sub-row::before {
    content: '';
    position: absolute;
    top: 0;
    left: 50%;
    transform: translateX(-50%);
    width: 2px;
    height: 20px;
    background: var(--rm-border);
  }

  .sub-row.no-pad-top {
    padding-top: 0;
  }

  .sub-node {
    padding: 8px 16px;
    border-radius: 6px;
    font-size: 0.82rem;
    font-weight: 500;
    border: 1px solid var(--rm-border);
    background: var(--rm-surface);
    color: var(--fg);
    transition: all 0.2s;
    font-family: var(--font-mono);
  }

  .sub-node:hover {
    border-color: var(--rm-muted);
    background: #1a1a2e;
    transform: translateY(-2px);
  }

  .sub-node.highlight-cyan {
    border-color: rgba(0, 212, 212, 0.4);
    color: var(--rm-cyan);
  }
  .sub-node.highlight-purple {
    border-color: rgba(168, 85, 247, 0.4);
    color: var(--rm-purple);
  }
  .sub-node.highlight-yellow {
    border-color: rgba(251, 191, 36, 0.4);
    color: var(--rm-yellow);
  }
  .sub-node.highlight-green {
    border-color: rgba(52, 211, 153, 0.4);
    color: var(--rm-green);
  }
  .sub-node.highlight-pink {
    border-color: rgba(244, 114, 182, 0.4);
    color: var(--rm-pink);
  }

  .section-with-sides {
    width: 100%;
    display: flex;
    align-items: flex-start;
    justify-content: center;
    gap: 20px;
    padding: 10px 0;
    margin-top: 20px;
  }

  .side-panel {
    background: var(--rm-surface);
    border: 1px solid var(--rm-border);
    border-radius: 8px;
    padding: 16px;
    min-width: 140px;
    max-width: 180px;
    font-size: 0.78rem;
  }

  .side-panel h4 {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--rm-muted);
    text-transform: uppercase;
    letter-spacing: 1px;
    margin-bottom: 10px;
  }

  .side-panel ul {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .side-panel ul li {
    color: var(--fg);
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 0.78rem;
  }

  .side-panel ul li::before {
    content: '›';
    color: var(--rm-muted);
  }

  .center-col {
    display: flex;
    flex-direction: column;
    align-items: center;
    flex: 1;
    max-width: 300px;
  }

  .legend {
    margin-top: 3rem;
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    justify-content: center;
    padding: 24px;
    border: 1px solid var(--rm-border);
    border-radius: 12px;
    background: var(--rm-surface);
  }

  .legend-item {
    display: flex;
    align-items: center;
    gap: 8px;
    font-size: 0.8rem;
    color: var(--rm-muted);
  }

  .legend-dot {
    width: 10px;
    height: 10px;
    border-radius: 50%;
  }

  .dot-cyan {
    background: var(--rm-cyan);
  }
  .dot-purple {
    background: var(--rm-purple);
  }
  .dot-yellow {
    background: var(--rm-yellow);
  }
  .dot-green {
    background: var(--rm-green);
  }
  .dot-pink {
    background: var(--rm-pink);
  }

  .phase-label {
    font-family: var(--font-mono);
    font-size: 0.65rem;
    text-transform: uppercase;
    letter-spacing: 2px;
    color: var(--rm-muted);
    margin-bottom: 8px;
    display: flex;
    align-items: center;
    gap: 8px;
  }

  .phase-label::before,
  .phase-label::after {
    content: '';
    flex: 1;
    height: 1px;
    background: var(--rm-border);
    max-width: 60px;
  }

  @media (max-width: 640px) {
    .section-with-sides {
      flex-direction: column;
      align-items: center;
    }
    .side-panel {
      max-width: 100%;
      width: 100%;
    }
    .main-node {
      white-space: normal;
      text-align: center;
      padding: 12px 20px;
      font-size: 0.95rem;
    }
  }
</style>
