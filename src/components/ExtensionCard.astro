---
interface Props {
  title: string;
  description: string;
  platform: string;
  demoUrl?: string;
  videoUrl?: string;
  installUrl?: string;
  repoUrl?: string;
  installs?: number;
}

const {
  title,
  description,
  platform,
  demoUrl,
  videoUrl,
  installUrl,
  repoUrl,
  installs,
} = Astro.props;
---

<article class="card" data-video={videoUrl}>
  {
    videoUrl && (
      <button class="video" type="button" aria-label={`Mở demo ${title}`}>
        <video
          src={videoUrl}
          muted
          loop
          playsinline
          preload="metadata"
        />
        <span class="play-badge" aria-hidden="true">
          <svg viewBox="0 0 24 24" width="20" height="20"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
        </span>
        <span class="expand-badge" aria-hidden="true">Click để xem to</span>
      </button>
    )
  }
  <span class="tag">{platform}</span>
  <h3>{title}</h3>
  <p>{description}</p>
  <div class="meta">
    {demoUrl && <a href={demoUrl}>Live demo &rarr;</a>}
    {installUrl && <a href={installUrl}>Install</a>}
    {repoUrl && <a href={repoUrl}>Source</a>}
    {installs != null && <span>{installs.toLocaleString()} installs</span>}
  </div>
</article>

<style>
  .video {
    position: relative;
    aspect-ratio: 16 / 10;
    margin: -0.15rem -0.15rem 0.6rem;
    border-radius: 6px;
    overflow: hidden;
    background: #000;
    border: 0;
    padding: 0;
    width: calc(100% + 0.3rem);
    cursor: zoom-in;
    display: block;
  }
  .video video {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
    pointer-events: none;
  }
  .play-badge {
    position: absolute;
    inset: 0;
    margin: auto;
    width: 48px;
    height: 48px;
    border-radius: 50%;
    background: rgba(7, 9, 14, 0.7);
    color: #fff;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: transform 200ms ease, background 200ms ease;
  }
  .video:hover .play-badge {
    transform: scale(1.08);
    background: rgba(7, 9, 14, 0.9);
  }
  .expand-badge {
    position: absolute;
    bottom: 0.4rem;
    right: 0.4rem;
    background: rgba(7, 9, 14, 0.85);
    color: #e2e8f0;
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
    opacity: 0;
    transition: opacity 200ms ease;
  }
  .video:hover .expand-badge,
  .video:focus-visible .expand-badge {
    opacity: 1;
  }
</style>
