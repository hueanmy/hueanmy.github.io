---
---

<header class="hero">
  <div class="hero-head">
    <img src="/avatar.png" alt="Meii" class="avatar" width="52" height="52" />
    <div>
      <h1 class="name">Meii</h1>
      <p class="status">
        <span class="dot"></span>
        Exploring AI · applying Claude to dev tools
      </p>
    </div>
  </div>

  <p class="tagline">
    Background in mobile, desktop, and web. Currently learning AI and applying
    Claude to developer tooling, AIDLC workflow, and QA automation —
    contributing to open source along the way.
  </p>

  <nav class="socials" aria-label="social links">
    <a href="https://github.com/hueanmy">GitHub</a>
    <a href="https://www.youtube.com/@studyingwithmeii">YouTube</a>
    <a href="https://www.tiktok.com/@studyingwithmeii">TikTok</a>
    <a href="https://www.facebook.com/profile.php?id=61589074324457">Facebook</a>
    <a href="mailto:ltmai93@gmail.com">Email</a>
  </nav>
</header>

<style>
  .hero {
    margin-bottom: 2.5rem;
  }

  .hero-head {
    display: flex;
    align-items: center;
    gap: 0.875rem;
    margin-bottom: 0.9rem;
  }

  .avatar {
    width: 52px;
    height: 52px;
    border-radius: 50%;
    border: 1px solid var(--border);
    flex-shrink: 0;
  }

  .name {
    font-size: 1.25rem;
    font-weight: 600;
    color: var(--fg);
    letter-spacing: -0.01em;
    line-height: 1.2;
  }

  .status {
    display: flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--fg-muted);
    margin-top: 0.15rem;
  }

  .dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: #4ade80;
    flex-shrink: 0;
  }

  .tagline {
    color: var(--fg-dim);
    font-size: 0.95rem;
    line-height: 1.7;
    max-width: 38rem;
    margin-bottom: 1.25rem;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 1.1rem;
    font-size: 0.85rem;
  }

  .socials a {
    color: var(--fg-dim);
  }

  .socials a:hover {
    color: var(--fg);
  }
</style>
