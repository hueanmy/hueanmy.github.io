---
---

<header class="hero">
  <div class="status">
    <span class="pulse"></span>
    <span>Building AI-native dev tools</span>
  </div>

  <div class="hero-head">
    <div class="avatar-wrap">
      <img
        src="/avatar.png"
        alt="Meii avatar"
        class="avatar"
        width="72"
        height="72"
      />
    </div>
    <h1 class="name">Meii <span class="bell">🔔</span></h1>
  </div>

  <p class="tagline">
    Developer building <strong>AI-driven</strong> editor extensions and developer
    tools. Shipping open source that automates the boring parts of delivering
    software.
  </p>

  <nav class="socials" aria-label="social links">
    <a href="https://github.com/hueanmy">GitHub</a>
    <a href="https://www.linkedin.com/in/mailethi/">LinkedIn</a>
    <a href="https://www.youtube.com/@studyingwithmeii">YouTube</a>
    <a href="https://www.tiktok.com/@studyingwithmeii">TikTok</a>
    <a href="mailto:ltmai93@gmail.com">Email</a>
    <a href="#support">Sponsor</a>
  </nav>
</header>

<style>
  .hero {
    margin-bottom: 4.5rem;
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.55rem;
    padding: 0.3rem 0.8rem 0.3rem 0.7rem;
    background: rgba(16, 20, 29, 0.6);
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.78rem;
    font-family: var(--font-mono);
    color: var(--fg-dim);
    margin-bottom: 1.5rem;
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .pulse {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #4ade80;
    box-shadow: 0 0 10px #4ade80;
    animation: pulse 2.2s ease-in-out infinite;
  }

  @keyframes pulse {
    0%,
    100% {
      opacity: 1;
      transform: scale(1);
    }
    50% {
      opacity: 0.45;
      transform: scale(0.85);
    }
  }

  .hero-head {
    display: flex;
    align-items: center;
    gap: 1.15rem;
    margin-bottom: 0.9rem;
  }

  .avatar-wrap {
    position: relative;
    flex-shrink: 0;
    padding: 2px;
    border-radius: 50%;
    background: var(--gradient-accent);
    box-shadow:
      0 0 30px rgba(94, 234, 212, 0.18),
      0 0 70px rgba(167, 139, 250, 0.12);
  }

  .avatar {
    display: block;
    width: 72px;
    height: 72px;
    border-radius: 50%;
    border: 2px solid var(--bg);
  }

  .name {
    font-size: 2.5rem;
    font-weight: 700;
    letter-spacing: -0.025em;
    background: var(--gradient-accent);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .bell {
    display: inline-block;
    -webkit-text-fill-color: initial;
    background: none;
    font-size: 0.7em;
    margin-left: 0.15em;
    transform-origin: top center;
    animation: bell-ring 3s ease-in-out infinite;
  }

  @keyframes bell-ring {
    0%, 70%, 100% { transform: rotate(0deg); }
    75% { transform: rotate(14deg); }
    80% { transform: rotate(-12deg); }
    85% { transform: rotate(8deg); }
    90% { transform: rotate(-6deg); }
    95% { transform: rotate(0deg); }
  }

  .tagline {
    color: var(--fg-dim);
    font-size: 1.05rem;
    max-width: 36rem;
    margin-bottom: 1.5rem;
  }

  .tagline strong {
    color: var(--fg);
    font-weight: 600;
    background: var(--gradient-accent);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
  }

  .socials {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    font-size: 0.9rem;
  }

  @media (max-width: 520px) {
    .name {
      font-size: 2rem;
    }
    .avatar,
    .avatar-wrap {
      width: 60px;
      height: 60px;
    }
    .avatar {
      width: 56px;
      height: 56px;
    }
  }
</style>
