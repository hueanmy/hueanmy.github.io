---
const tabs = [
  { id: 'resources', label: 'Free Resources' },
  { id: 'projects',  label: 'Projects' },
  { id: 'writing',   label: 'Writing' },
  { id: 'about',     label: 'About Me' },
];
---

<nav class="tab-nav" role="tablist" aria-label="Site sections">
  {tabs.map((tab, i) => (
    <button
      class="tab-btn"
      role="tab"
      data-tab={tab.id}
      aria-selected={i === 0 ? 'true' : 'false'}
      aria-controls={`panel-${tab.id}`}
      tabindex={i === 0 ? 0 : -1}
    >
      {tab.label}
    </button>
  ))}
  <span class="tab-ink" aria-hidden="true"></span>
</nav>

<style>
  .tab-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    align-items: center;
    gap: 0;
    margin-bottom: 3rem;
    margin-inline: -1.5rem;
    padding-inline: 1.5rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 85%, transparent);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tab-nav::-webkit-scrollbar { display: none; }

  .tab-btn {
    position: relative;
    padding: 0.75rem 1.1rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg-muted);
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: color 150ms ease;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    flex-shrink: 0;
  }

  .tab-btn:hover {
    color: var(--fg);
  }

  .tab-btn[aria-selected='true'] {
    color: var(--fg);
  }

  /* sliding underline */
  .tab-ink {
    position: absolute;
    bottom: -1px;
    left: 0;
    height: 2px;
    background: var(--accent);
    border-radius: 2px 2px 0 0;
    transition: left 200ms cubic-bezier(.4,0,.2,1), width 200ms cubic-bezier(.4,0,.2,1);
    pointer-events: none;
  }
</style>

<script>
  (() => {
    const nav = document.querySelector('.tab-nav');
    if (!nav) return;

    const buttons = nav.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const ink     = nav.querySelector<HTMLElement>('.tab-ink');
    const panels  = document.querySelectorAll<HTMLElement>('.tab-panel');

    function moveInk(btn: HTMLButtonElement) {
      if (!ink || !nav) return;
      const navRect = nav.getBoundingClientRect();
      const btnRect = btn.getBoundingClientRect();
      // account for sticky nav's scroll position
      const scrollLeft = (nav as HTMLElement).scrollLeft;
      ink.style.left  = `${btnRect.left - navRect.left + scrollLeft}px`;
      ink.style.width = `${btnRect.width}px`;
    }

    function activate(btn: HTMLButtonElement) {
      const target = btn.dataset.tab;
      buttons.forEach(b => {
        const active = b === btn;
        b.setAttribute('aria-selected', active ? 'true' : 'false');
        b.tabIndex = active ? 0 : -1;
      });
      panels.forEach(p => {
        p.hidden = p.dataset.panel !== target;
      });
      moveInk(btn);
    }

    // keyboard nav
    nav.addEventListener('keydown', (e) => {
      const active = nav.querySelector<HTMLButtonElement>('.tab-btn[aria-selected="true"]');
      const list = Array.from(buttons);
      const idx  = list.indexOf(active!);
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        const next = list[(idx + 1) % list.length];
        next.focus();
        activate(next);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        const prev = list[(idx - 1 + list.length) % list.length];
        prev.focus();
        activate(prev);
      }
    });

    buttons.forEach(btn => {
      btn.addEventListener('click', () => activate(btn));
    });

    // init ink on first active tab
    const first = nav.querySelector<HTMLButtonElement>('.tab-btn[aria-selected="true"]');
    if (first) {
      // wait for layout
      requestAnimationFrame(() => moveInk(first));
    }

    // reposition on resize
    window.addEventListener('resize', () => {
      const active = nav.querySelector<HTMLButtonElement>('.tab-btn[aria-selected="true"]');
      if (active) moveInk(active);
    });
  })();
</script>
