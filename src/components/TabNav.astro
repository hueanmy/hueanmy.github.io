---
const tabs = [
  { id: 'resources', label: 'Free Resources' },
  { id: 'projects',  label: 'Projects' },
  { id: 'writing',   label: 'Writing' },
  { id: 'about',     label: 'About Me' },
];
---

<nav class="tab-nav" role="tablist" aria-label="Site sections">
  {tabs.map((tab, i) => (
    <button
      class="tab-btn"
      role="tab"
      data-tab={tab.id}
      aria-selected={i === 0 ? 'true' : 'false'}
      aria-controls={`panel-${tab.id}`}
      tabindex={i === 0 ? 0 : -1}
    >
      {tab.label}
    </button>
  ))}
</nav>

<style>
  .tab-nav {
    position: sticky;
    top: 0;
    z-index: 50;
    display: flex;
    gap: 0;
    margin-bottom: 2.5rem;
    margin-inline: -1.5rem;
    padding-inline: 1.5rem;
    border-bottom: 1px solid var(--border);
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: blur(8px);
    -webkit-backdrop-filter: blur(8px);
    overflow-x: auto;
    scrollbar-width: none;
  }

  .tab-nav::-webkit-scrollbar { display: none; }

  .tab-btn {
    position: relative;
    padding: 0.7rem 1rem;
    font-family: var(--font-sans);
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--fg-muted);
    background: none;
    border: none;
    cursor: pointer;
    white-space: nowrap;
    transition: color 120ms ease;
    outline: none;
    -webkit-tap-highlight-color: transparent;
    flex-shrink: 0;
  }

  .tab-btn::after {
    content: '';
    position: absolute;
    bottom: -1px;
    left: 0;
    right: 0;
    height: 2px;
    background: var(--fg);
    border-radius: 1px;
    opacity: 0;
    transition: opacity 120ms ease;
  }

  .tab-btn:hover {
    color: var(--fg-dim);
  }

  .tab-btn[aria-selected='true'] {
    color: var(--fg);
  }

  .tab-btn[aria-selected='true']::after {
    opacity: 1;
  }
</style>

<script>
  (() => {
    const nav = document.querySelector('.tab-nav');
    if (!nav) return;

    const buttons = nav.querySelectorAll<HTMLButtonElement>('.tab-btn');
    const panels  = document.querySelectorAll<HTMLElement>('.tab-panel');

    function activate(btn: HTMLButtonElement) {
      const target = btn.dataset.tab;
      buttons.forEach(b => {
        const active = b === btn;
        b.setAttribute('aria-selected', active ? 'true' : 'false');
        b.tabIndex = active ? 0 : -1;
      });
      panels.forEach(p => {
        p.hidden = p.dataset.panel !== target;
      });
    }

    nav.addEventListener('keydown', (e) => {
      const active = nav.querySelector<HTMLButtonElement>('.tab-btn[aria-selected="true"]');
      const list = Array.from(buttons);
      const idx  = list.indexOf(active!);
      if (e.key === 'ArrowRight') {
        e.preventDefault();
        const next = list[(idx + 1) % list.length];
        next.focus(); activate(next);
      } else if (e.key === 'ArrowLeft') {
        e.preventDefault();
        const prev = list[(idx - 1 + list.length) % list.length];
        prev.focus(); activate(prev);
      }
    });

    buttons.forEach(btn => btn.addEventListener('click', () => activate(btn)));
  })();
</script>
