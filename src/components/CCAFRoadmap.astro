---
const meta = [
  { k: '60', v: 'questions', vi: 'câu' },
  { k: '120', v: 'minutes', vi: 'phút' },
  { k: '720', v: '/1000 pass', vi: '/1000 pass' },
  { k: '$99', v: 'exam fee', vi: 'phí thi' },
];

const cards = [
  {
    href: '/cca-f-roadmap.html',
    badge_en: '30h · 4-week plan',
    badge_vi: '30h · kế hoạch 4 tuần',
    title: 'Study Roadmap',
    tagline_en: '30h study plan over 4 weeks — 5 domains, 6 exam scenarios, common traps and mental models.',
    tagline_vi: 'Lộ trình ôn 30h chia 4 tuần — 5 domains, 6 exam scenarios, common traps và mental models.',
    bullets_en: [
      ['①', 'Foundation · Agentic', '8h'],
      ['②', 'Tools & Claude Code', '10h'],
      ['③', 'Prompt & Context', '8h'],
      ['④', 'Practice scenarios', '4h'],
    ],
    cta_en: 'View roadmap →',
    cta_vi: 'Xem roadmap →',
  },
  {
    href: '/cca-f-knowledge-map.html',
    badge_en: 'Per-domain reference',
    badge_vi: 'Tham chiếu theo domain',
    title: 'Knowledge Map',
    tagline_en: 'Deep-dive per domain — knowledge items K1…Kn, code snippets, traps & refs. Quick lookup.',
    tagline_vi: 'Deep-dive từng domain — knowledge items K1…Kn, code snippets, traps & refs. Tra cứu nhanh.',
    bullets_en: [
      ['K', '35+ knowledge items'],
      ['◆', 'Code snippets per concept'],
      ['◆', 'Sidebar nav by domain'],
      ['◆', 'Traps + models inline'],
    ],
    cta_en: 'View knowledge map →',
    cta_vi: 'Xem knowledge map →',
  },
  {
    href: '/cca-f-vocabulary.html',
    badge_en: 'EN ↔ VI glossary',
    badge_vi: 'Từ điển EN ↔ VI',
    title: 'Vocabulary Guide',
    tagline_en: 'English vocabulary common in exams — explained in Vietnamese with real examples.',
    tagline_vi: 'Từ vựng tiếng Anh hay gặp trong đề thi — giải thích bằng tiếng Việt + ví dụ thực tế.',
    bullets_en: [
      ['A', '5 domain-aligned categories'],
      ['?', 'MCQ question phrases'],
      ['→', 'Search EN or VI'],
      ['#', 'Tag: Core / Trap / Pattern'],
    ],
    cta_en: 'View vocabulary →',
    cta_vi: 'Xem từ vựng →',
  },
];
---

<section id="ccaf-exam" class="exam-section">
  <div class="section-head">
    <div class="head-left">
      <h2>CCA-F Exam</h2>
      <p class="head-sub">Claude Certified Architect — Foundations</p>
    </div>
    <div class="head-actions">
      <a class="head-link" href="https://github.com/hueanmy/cca-f-roadmap" target="_blank" rel="noopener">Working examples on GitHub ↗</a>
    </div>
  </div>

  <ul class="meta-pills">
    {meta.map((m) => (
      <li>
        <strong>{m.k}</strong>
        <span class="lang-en">{m.v}</span>
        <span class="lang-vi">{m.vi}</span>
      </li>
    ))}
    <li class="meta-soft">
      <span class="lang-en">scenario-based, not trivia</span>
      <span class="lang-vi">scenario-based, không phải trivia</span>
    </li>
  </ul>

  <div class="exam-grid">
    {cards.map((c) => (
      <a class="exam-card" href={c.href} target="_blank" rel="noopener">
        <div class="exam-body">
          <span class="exam-badge">
            <span class="lang-en">{c.badge_en}</span>
            <span class="lang-vi">{c.badge_vi}</span>
          </span>
          <h3 class="exam-title">{c.title}</h3>
          <p class="exam-tagline">
            <span class="lang-en">{c.tagline_en}</span>
            <span class="lang-vi">{c.tagline_vi}</span>
          </p>
          <ul class="bullets">
            {c.bullets_en.map((b) => (
              <li>
                <span class="bullet-mark">{b[0]}</span>
                <span class="bullet-text">{b[1]}</span>
                {b[2] && <span class="bullet-extra">{b[2]}</span>}
              </li>
            ))}
          </ul>
        </div>
        <div class="exam-footer">
          <span class="lang-en">{c.cta_en}</span>
          <span class="lang-vi">{c.cta_vi}</span>
        </div>
      </a>
    ))}
  </div>
</section>

<style>
  .exam-section { margin-top: 2.5rem; }

  .section-head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.85rem;
    padding-bottom: 0.65rem;
    border-bottom: 1px solid var(--border);
  }
  .head-left h2 {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-muted);
    margin: 0 0 0.2rem;
  }
  .head-sub { font-size: 0.86rem; color: var(--fg); margin: 0; }
  .head-actions { display: flex; gap: 1.25rem; flex-wrap: wrap; justify-content: flex-end; padding-top: 0.15rem; }
  .head-link {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    transition: color 120ms;
  }
  .head-link:hover { color: var(--accent-hover); text-decoration: underline; text-underline-offset: 3px; }

  .meta-pills {
    list-style: none;
    padding: 0;
    margin: 0 0 1.25rem;
    display: flex;
    gap: 0.5rem;
    flex-wrap: wrap;
  }
  .meta-pills li {
    font-family: var(--font-mono);
    font-size: 0.66rem;
    color: var(--fg-muted);
    border: 1px solid var(--border);
    border-radius: 20px;
    padding: 2px 9px;
  }
  .meta-pills strong { color: var(--fg); font-weight: 600; }
  .meta-pills li.meta-soft { color: var(--fg-dim); border-color: transparent; padding-left: 0; }

  .exam-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1rem;
  }

  .exam-card {
    display: flex;
    flex-direction: column;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition: box-shadow 150ms ease;
    overflow: hidden;
  }
  .exam-card:hover { box-shadow: 0 4px 20px rgba(0,0,0,0.07); }

  .exam-body {
    flex: 1;
    padding: 1rem 1rem 0.75rem;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .exam-badge {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 2px 8px;
    border-radius: 20px;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    opacity: 0.8;
  }

  .exam-title {
    font-family: var(--font-serif);
    font-size: 1.0625rem;
    font-weight: 500;
    color: var(--fg);
    line-height: 1.3;
    margin: 0;
  }

  .exam-tagline {
    font-size: 0.8rem;
    color: var(--fg-dim);
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }

  .bullets {
    list-style: none;
    padding: 0;
    margin: 0.25rem 0 0;
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
    flex: 1;
  }
  .bullets li {
    display: grid;
    grid-template-columns: 1.2rem 1fr auto;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.74rem;
    color: var(--fg);
    padding: 0.12rem 0;
  }
  .bullet-mark {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--accent);
    text-align: center;
  }
  .bullet-extra {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--fg-muted);
  }

  .exam-footer {
    border-top: 1px solid var(--border);
    padding: 0.65rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    color: var(--accent);
    transition: color 120ms;
  }
  .exam-card:hover .exam-footer { color: var(--accent-hover); }

  @media (max-width: 720px) {
    .exam-grid { grid-template-columns: 1fr 1fr; }
    .exam-grid > .exam-card:nth-child(3) { grid-column: 1 / -1; }
  }
  @media (max-width: 480px) {
    .exam-grid { grid-template-columns: 1fr; }
    .exam-grid > .exam-card:nth-child(3) { grid-column: auto; }
  }
  @media (max-width: 520px) {
    .section-head { flex-direction: column; gap: 0.5rem; }
    .head-actions { justify-content: flex-start; }
  }
</style>
