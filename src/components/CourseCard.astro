---
interface Props {
  id: string;
  title: string;
  description: string;
  description_en?: string;
  tagline?: string;
  thumbnail?: string;
  duration?: string;
  tags?: string[];
  featured?: boolean;
  paid?: boolean;
  price?: string;
  demoUrl?: string;
  video?: string;
}

const {
  id,
  title,
  description,
  description_en,
  tagline,
  thumbnail,
  duration,
  tags = [],
  featured,
  paid,
  price,
  demoUrl,
  video,
} = Astro.props;

const priceLabel = paid ? (price ?? 'Paid') : null;
const href = (demoUrl && !video) ? demoUrl : `/courses/${id}/`;
---

<a class={`card course${featured ? ' featured' : ''}`} href={href}>
  {priceLabel && <span class="price-badge inline">{priceLabel}</span>}
  <h3>{title}</h3>
  {tagline && <p class="tagline">{tagline}</p>}
  {
    description_en
      ? (<p><span class="lang-en">{description_en}</span><span class="lang-vi">{description}</span></p>)
      : (<p>{description}</p>)
  }
  {
    tags.length > 0 && (
      <div class="tech">
        {tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  a.card.course {
    display: flex;
    flex-direction: column;
    color: inherit;
    padding: 0.9rem;
    gap: 0.4rem;
  }
  .price-badge {
    background: var(--accent-soft);
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 600;
    padding: 0.15rem 0.5rem;
    border-radius: 4px;
    letter-spacing: 0.02em;
    align-self: flex-start;
    margin-bottom: 0.25rem;
  }
  a.card.course :global(h3) {
    font-size: 0.95rem;
    margin: 0;
  }
  .tagline {
    color: var(--accent);
    font-size: 0.7rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    margin: 0;
  }
  a.card.course :global(p) {
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .tech :global(.tag) {
    font-size: 0.66rem;
    padding: 0.1rem 0.45rem;
  }
  .card.featured {
    border-color: var(--border);
  }
</style>
