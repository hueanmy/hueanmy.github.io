---
interface Props {
  id: string;
  title: string;
  description: string;
  tagline?: string;
  thumbnail?: string;
  duration?: string;
  tags?: string[];
  featured?: boolean;
}

const {
  id,
  title,
  description,
  tagline,
  thumbnail,
  duration,
  tags = [],
  featured,
} = Astro.props;

const href = `/courses/${id}/`;
---

<a class={`card course${featured ? ' featured' : ''}`} href={href}>
  {
    thumbnail && (
      <div class="thumb">
        <img src={thumbnail} alt={title} loading="lazy" />
        {duration && <span class="duration">{duration}</span>}
      </div>
    )
  }
  <h3>{title}</h3>
  {tagline && <p class="tagline">{tagline}</p>}
  <p>{description}</p>
  {
    tags.length > 0 && (
      <div class="tech">
        {tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  a.card.course {
    display: block;
    color: inherit;
  }
  .thumb {
    position: relative;
    aspect-ratio: 9 / 16;
    max-height: 220px;
    margin: -0.25rem -0.25rem 0.85rem;
    border-radius: 8px;
    overflow: hidden;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .duration {
    position: absolute;
    bottom: 0.5rem;
    right: 0.5rem;
    background: rgba(7, 9, 14, 0.85);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.72rem;
    padding: 0.15rem 0.45rem;
    border-radius: 4px;
  }
  .tagline {
    color: var(--accent);
    font-size: 0.82rem;
    font-family: var(--font-mono);
    margin: 0.1rem 0 0.5rem;
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem;
    margin-top: 0.75rem;
  }
  .card.featured {
    border-color: rgba(94, 234, 212, 0.35);
  }
</style>
