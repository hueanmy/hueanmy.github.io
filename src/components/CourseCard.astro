---
interface Props {
  id: string;
  title: string;
  description: string;
  tagline?: string;
  thumbnail?: string;
  duration?: string;
  tags?: string[];
  featured?: boolean;
}

const {
  id,
  title,
  description,
  tagline,
  thumbnail,
  duration,
  tags = [],
  featured,
} = Astro.props;

const href = `/courses/${id}/`;
---

<a class={`card course${featured ? ' featured' : ''}`} href={href}>
  {
    thumbnail && (
      <div class="thumb">
        <img src={thumbnail} alt={title} loading="lazy" />
        {duration && <span class="duration">{duration}</span>}
      </div>
    )
  }
  <h3>{title}</h3>
  {tagline && <p class="tagline">{tagline}</p>}
  <p>{description}</p>
  {
    tags.length > 0 && (
      <div class="tech">
        {tags.map((t) => (
          <span class="tag">{t}</span>
        ))}
      </div>
    )
  }
</a>

<style>
  a.card.course {
    display: flex;
    flex-direction: column;
    color: inherit;
    padding: 0.9rem;
    gap: 0.4rem;
  }
  .thumb {
    position: relative;
    aspect-ratio: 16 / 10;
    max-height: 130px;
    margin: -0.15rem -0.15rem 0.3rem;
    border-radius: 6px;
    overflow: hidden;
    background: #000;
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .thumb img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    display: block;
  }
  .duration {
    position: absolute;
    bottom: 0.4rem;
    right: 0.4rem;
    background: rgba(7, 9, 14, 0.85);
    color: var(--fg);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    padding: 0.1rem 0.4rem;
    border-radius: 4px;
  }
  a.card.course :global(h3) {
    font-size: 0.95rem;
    margin: 0;
  }
  .tagline {
    color: var(--accent);
    font-size: 0.7rem;
    font-family: var(--font-mono);
    letter-spacing: 0.08em;
    margin: 0;
  }
  a.card.course :global(p) {
    font-size: 0.82rem;
    line-height: 1.5;
    margin: 0;
    display: -webkit-box;
    -webkit-line-clamp: 3;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .tech {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem;
    margin-top: auto;
    padding-top: 0.5rem;
  }
  .tech :global(.tag) {
    font-size: 0.66rem;
    padding: 0.1rem 0.45rem;
  }
  .card.featured {
    border-color: rgba(94, 234, 212, 0.35);
  }
</style>
