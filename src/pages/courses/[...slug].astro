---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const courses = await getCollection('courses');
  return courses.map((course) => ({
    params: { slug: course.id },
    props: { course },
  }));
}

const { course } = Astro.props;
const { Content } = await render(course);
const d = course.data;
const dateStr = d.date
  ? d.date.toISOString().slice(0, 10)
  : undefined;
---

<Layout title={`${d.title} — Meii`} description={d.description}>
  <main class="course-main">
    <a class="back" href="/">
      &larr; <span class="lang-en">Back</span><span class="lang-vi">Trang chủ</span>
    </a>

    <header class="hero">
      {d.tagline && <p class="tagline">{d.tagline}</p>}
      <h1>{d.title}</h1>
      <p class="lead">
        {d.description_en
          ? <><span class="lang-en">{d.description_en}</span><span class="lang-vi">{d.description}</span></>
          : d.description
        }
      </p>
      {d.courseUrl && (
        <p class="ref">
          <span class="lang-en">Based on</span>
          <span class="lang-vi">Dựa theo</span>{' '}
          <a href={d.courseUrl} target="_blank" rel="noopener">
            {d.courseUrl.replace(/^https?:\/\//, '')} &rarr;
          </a>
        </p>
      )}
      <div class="meta">
        {dateStr && <span>{dateStr}</span>}
        {d.duration && <span>{d.duration}</span>}
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    {d.paid && (
      <aside class="buy-cta">
        <div class="buy-text">
          <span class="buy-label">
            <span class="lang-en">Paid course</span>
            <span class="lang-vi">Khóa học có phí</span>
          </span>
          {d.price && <span class="buy-price">{d.price}</span>}
        </div>
        {d.buyUrl ? (
          <a class="buy-btn" href={d.buyUrl} target="_blank" rel="noopener">
            <span class="lang-en">Buy course &rarr;</span>
            <span class="lang-vi">Mua khóa học &rarr;</span>
          </a>
        ) : (
          <span class="buy-btn disabled">
            <span class="lang-en">Coming soon</span>
            <span class="lang-vi">Sắp mở bán</span>
          </span>
        )}
      </aside>
    )}

    {d.video && (
      <figure class="video-wrap">
        <video
          src={d.video}
          controls
          playsinline
          preload="metadata"
          poster={d.thumbnail}
        />
        {d.videoFull && d.videoFull !== d.video && (
          <figcaption>
            <a href={d.videoFull}>
              <span class="lang-en">Watch full-length version &rarr;</span>
              <span class="lang-vi">Xem bản đầy đủ &rarr;</span>
            </a>
          </figcaption>
        )}
      </figure>
    )}

    {d.demoUrl && !d.video && (
      <p class="demo-link">
        <a href={d.demoUrl} target="_blank" rel="noopener">
          <span class="lang-en">▶ Open interactive demo &rarr;</span>
          <span class="lang-vi">▶ Mở interactive demo &rarr;</span>
        </a>
      </p>
    )}

    <section class="prose">
      <Content />
    </section>

    {d.sourceFiles.length > 0 && d.sourceDir && (
      <section class="source">
        <h2>Source</h2>
        <ul>
          {d.sourceFiles.map((f) => {
            const isHtml = f.toLowerCase().endsWith('.html');
            const href = `${d.sourceDir}/${f}`;
            return (
              <li>
                {isHtml ? (
                  <a href={href} target="_blank" rel="noopener" class="view">{f} ↗</a>
                ) : (
                  <a href={href} download>{f}</a>
                )}
              </li>
            );
          })}
        </ul>
        {d.repoUrl && (
          <p>
            <a href={d.repoUrl}>
              <span class="lang-en">View on GitHub &rarr;</span>
              <span class="lang-vi">Xem trên GitHub &rarr;</span>
            </a>
          </p>
        )}
      </section>
    )}
  </main>
</Layout>

<style>
  .course-main { max-width: 760px; }
  .back {
    display: inline-block;
    font-size: 0.82rem;
    color: var(--fg-dim);
    margin-bottom: 2rem;
  }
  .hero { margin-bottom: 2rem; }
  .tagline {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1.1;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .lead { color: var(--fg-dim); font-size: 1.02rem; line-height: 1.55; }
  .ref {
    margin-top: 0.75rem;
    font-size: 0.85rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
    font-size: 0.78rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    align-items: center;
  }
  .buy-cta {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    margin: 1.75rem 0 0.5rem;
    padding: 1rem 1.15rem;
    background: var(--bg-card);
    border: 1px solid var(--accent);
    border-radius: var(--radius);
  }
  .buy-text { display: flex; flex-direction: column; gap: 0.2rem; }
  .buy-label {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    text-transform: uppercase;
    letter-spacing: 0.12em;
    color: var(--fg-muted);
  }
  .buy-price {
    font-size: 1.4rem;
    font-weight: 700;
    color: var(--accent);
  }
  .buy-btn {
    display: inline-block;
    padding: 0.7rem 1.2rem;
    background: var(--accent);
    color: #fff;
    font-weight: 600;
    border-radius: var(--radius);
    font-size: 0.92rem;
    transition: background 150ms ease;
    white-space: nowrap;
  }
  .buy-btn:hover { background: var(--accent-hover); color: #fff; }
  .buy-btn.disabled {
    background: var(--bg-subtle);
    color: var(--fg-muted);
    border: 1px solid var(--border);
    cursor: not-allowed;
  }
  @media (max-width: 520px) {
    .buy-cta { flex-direction: column; align-items: stretch; text-align: center; }
  }
  .video-wrap { margin: 2rem 0 2.5rem; text-align: center; }
  .video-wrap video {
    max-width: 360px;
    width: 100%;
    aspect-ratio: 9 / 16;
    border-radius: var(--radius);
    background: #000;
    border: 1px solid var(--border);
  }
  .video-wrap figcaption { margin-top: 0.75rem; font-size: 0.82rem; }
  .demo-link { margin: 1.5rem 0 2rem; }
  .demo-link a {
    display: inline-block;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .demo-link a:hover { background: rgba(192,87,42,0.15); }
  .prose :global(h3) { font-family: var(--font-serif); font-size: 1.05rem; margin-top: 1.75rem; margin-bottom: 0.5rem; }
  .prose :global(p) { color: var(--fg-dim); margin-bottom: 0.85rem; }
  .prose :global(ol), .prose :global(ul) { color: var(--fg-dim); padding-left: 1.25rem; margin-bottom: 0.85rem; }
  .prose :global(li) { margin-bottom: 0.35rem; }
  .prose :global(strong) { color: var(--fg); }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }
  .prose :global(pre) {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    overflow-x: auto;
    margin: 1rem 0;
  }
  .prose :global(pre code) { background: transparent; color: var(--fg); padding: 0; font-size: 0.82rem; }
  .source { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .source h2 {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-muted);
    margin-bottom: 1rem;
  }
  .source ul { list-style: none; display: flex; flex-wrap: wrap; gap: 0.5rem; padding: 0; margin-bottom: 1rem; }
  .source li a {
    display: inline-block;
    padding: 0.3rem 0.7rem;
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: 6px;
    font-family: var(--font-mono);
    font-size: 0.8rem;
  }
  .source li a:hover { border-color: var(--accent); }
  .source li a.view {
    background: var(--accent-soft);
    border-color: var(--accent);
    color: var(--accent);
  }
  .source li a.view:hover { background: rgba(192,87,42,0.15); }
</style>