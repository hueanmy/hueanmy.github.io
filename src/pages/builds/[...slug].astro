---
import { getCollection, render } from 'astro:content';
import Layout from '../../layouts/Layout.astro';

export async function getStaticPaths() {
  const builds = await getCollection('builds');
  return builds.map((build) => ({
    params: { slug: build.id },
    props: { build },
  }));
}

const { build } = Astro.props;
const { Content } = await render(build);
const d = build.data;
const dateStr = d.date ? d.date.toISOString().slice(0, 10) : undefined;
---

<Layout title={`${d.title} — Meii`} description={d.description}>
  <main class="course-main">
    <a class="back" href="/">
      &larr; <span class="lang-en">Back</span><span class="lang-vi">Trang chủ</span>
    </a>

    <header class="hero">
      {d.tagline && <p class="tagline">{d.tagline}</p>}
      <h1>{d.title}</h1>
      <p class="lead">
        {d.description_en
          ? <><span class="lang-en">{d.description_en}</span><span class="lang-vi">{d.description}</span></>
          : d.description
        }
      </p>
      <div class="meta">
        {dateStr && <span>{dateStr}</span>}
        {d.tags.map((t) => <span class="tag">{t}</span>)}
      </div>
    </header>

    {d.demoUrl && (
      <p class="demo-link">
        <a href={d.demoUrl} target="_blank" rel="noopener">
          <span class="lang-en">▶ Open interactive demo &rarr;</span>
          <span class="lang-vi">▶ Mở interactive demo &rarr;</span>
        </a>
      </p>
    )}

    <section class="prose">
      <Content />
    </section>

    {d.repoUrl && (
      <section class="source">
        <p>
          <a href={d.repoUrl} target="_blank" rel="noopener">
            <span class="lang-en">View on GitHub &rarr;</span>
            <span class="lang-vi">Xem trên GitHub &rarr;</span>
          </a>
        </p>
      </section>
    )}
  </main>
</Layout>

<style>
  .course-main { max-width: 760px; }
  .back {
    display: inline-block;
    font-size: 0.82rem;
    color: var(--fg-dim);
    margin-bottom: 2rem;
  }
  .hero { margin-bottom: 2rem; }
  .tagline {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    letter-spacing: 0.12em;
    margin-bottom: 0.75rem;
  }
  .hero h1 {
    font-family: var(--font-serif);
    font-size: 2rem;
    line-height: 1.1;
    font-weight: 600;
    margin-bottom: 0.75rem;
  }
  .lead { color: var(--fg-dim); font-size: 1.02rem; line-height: 1.55; }
  .meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.65rem;
    margin-top: 1rem;
    font-size: 0.78rem;
    color: var(--fg-muted);
    font-family: var(--font-mono);
    align-items: center;
  }
  .demo-link { margin: 1.5rem 0 2rem; }
  .demo-link a {
    display: inline-block;
    padding: 0.65rem 1.1rem;
    border: 1px solid var(--accent);
    border-radius: var(--radius);
    font-family: var(--font-mono);
    font-size: 0.85rem;
    background: var(--accent-soft);
    color: var(--accent);
  }
  .demo-link a:hover { background: rgba(192,87,42,0.15); }

  /* ── Prose ── */
  .prose :global(h2) {
    font-family: var(--font-serif);
    font-size: 1.3rem;
    font-weight: 600;
    margin-top: 2.2rem;
    margin-bottom: 0.6rem;
    color: var(--fg);
    padding-bottom: 0.4rem;
    border-bottom: 1px solid var(--border);
  }
  .prose :global(h3) {
    font-family: var(--font-serif);
    font-size: 1.05rem;
    font-weight: 500;
    margin-top: 1.6rem;
    margin-bottom: 0.45rem;
  }
  .prose :global(p) { color: var(--fg-dim); margin-bottom: 0.85rem; font-size: 0.975rem; line-height: 1.7; }
  .prose :global(ul), .prose :global(ol) { color: var(--fg-dim); padding-left: 1.25rem; margin-bottom: 0.85rem; }
  .prose :global(li) { margin-bottom: 0.35rem; font-size: 0.975rem; line-height: 1.65; }
  .prose :global(strong) { color: var(--fg); }
  .prose :global(code) {
    font-family: var(--font-mono);
    font-size: 0.85em;
    background: var(--accent-soft);
    color: var(--accent);
    padding: 0.1rem 0.35rem;
    border-radius: 4px;
  }
  .prose :global(pre) {
    background: var(--bg-subtle);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.9rem 1rem;
    overflow-x: auto;
    margin: 1rem 0;
  }
  .prose :global(pre code) { background: transparent; color: var(--fg-dim); padding: 0; font-size: 0.82rem; }
  .prose :global(hr) { border: none; border-top: 1px solid var(--border); margin: 2rem 0; }

  /* ── Pipeline diagram ── */
  .prose :global(.pipeline-diagram) { margin: 1.5rem 0 2rem; overflow-x: auto; }
  .prose :global(.pipeline-steps) {
    display: flex;
    align-items: center;
    gap: 0;
    min-width: max-content;
    padding: 0.25rem 0;
  }
  .prose :global(.pipe-step) { display: flex; flex-direction: column; align-items: center; gap: 0.3rem; }
  .prose :global(.pipe-box) {
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.55rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--fg);
    white-space: nowrap;
  }
  .prose :global(.pipe-box.accent) { background: var(--accent-soft); border-color: var(--accent); color: var(--accent); }
  .prose :global(.pipe-label) {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    color: var(--fg-muted);
    letter-spacing: 0.04em;
    text-align: center;
  }
  .prose :global(.pipe-label.accent) { color: var(--accent); }
  .prose :global(.pipe-arrow) {
    display: flex;
    align-items: center;
    padding: 0 0.4rem 1.2rem;
    color: var(--fg-muted);
    font-size: 0.9rem;
  }

  /* ── Architecture diagram ── */
  .prose :global(.arch-diagram) { margin: 1.5rem 0 2rem; display: flex; flex-direction: column; gap: 0; }
  .prose :global(.arch-layer) { display: flex; flex-direction: column; align-items: stretch; }
  .prose :global(.arch-layer-label) {
    font-family: var(--font-mono);
    font-size: 0.6rem;
    font-weight: 500;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--fg-muted);
    margin-bottom: 0.5rem;
  }
  .prose :global(.arch-row) { display: flex; gap: 0.65rem; align-items: stretch; }
  .prose :global(.arch-box) {
    flex: 1;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    padding: 0.7rem 0.9rem;
  }
  .prose :global(.arch-box.wide) { flex: 2; }
  .prose :global(.arch-box.accent-border) { border-color: var(--accent); background: var(--accent-soft); }
  .prose :global(.arch-box.muted) { background: var(--bg-subtle); }
  .prose :global(.arch-box-title) {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    color: var(--fg);
    margin-bottom: 0.2rem;
  }
  .prose :global(.arch-box.accent-border .arch-box-title) { color: var(--accent); }
  .prose :global(.arch-box.muted .arch-box-title) { color: var(--fg-muted); }
  .prose :global(.arch-box-desc) {
    font-family: var(--font-sans);
    font-size: 0.72rem;
    color: var(--fg-muted);
    line-height: 1.45;
  }
  .prose :global(.arch-connector) {
    display: flex;
    justify-content: center;
    padding: 0.3rem 0;
    color: var(--border);
    font-size: 1rem;
    line-height: 1;
  }
  .prose :global(.arch-connector-line) {
    width: 1px;
    height: 1.75rem;
    background: var(--border);
    position: relative;
  }
  .prose :global(.arch-connector-line)::after {
    content: '';
    position: absolute;
    bottom: -4px;
    left: 50%;
    transform: translateX(-50%);
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid var(--border);
  }

  /* ── Technique table ── */
  .prose :global(.technique-table) {
    width: 100%;
    border-collapse: collapse;
    margin: 1rem 0 1.5rem;
    font-size: 0.875rem;
  }
  .prose :global(.technique-table th) {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--fg-muted);
    padding: 0.45rem 0.75rem;
    border-bottom: 1px solid var(--border);
    text-align: left;
  }
  .prose :global(.technique-table td) {
    padding: 0.55rem 0.75rem;
    border-bottom: 1px solid var(--border);
    vertical-align: top;
    color: var(--fg-dim);
    line-height: 1.5;
  }
  .prose :global(.technique-table td:first-child) {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--accent);
    white-space: nowrap;
  }
  .prose :global(.technique-table tr:last-child td) { border-bottom: none; }
  .prose :global(.technique-table tr:hover td) { background: var(--bg-subtle); }

  /* ── Source link ── */
  .source { margin-top: 2.5rem; padding-top: 1.5rem; border-top: 1px solid var(--border); }
  .source a {
    font-family: var(--font-mono);
    font-size: 0.82rem;
    color: var(--accent);
  }
  .source a:hover { text-decoration: underline; text-underline-offset: 3px; }
</style>
