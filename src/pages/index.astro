---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ClaudeRoadmap from '../components/ClaudeRoadmap.astro';
import SectionNav from '../components/SectionNav.astro';
import ExtensionCard from '../components/ExtensionCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CourseCard from '../components/CourseCard.astro';
import Support from '../components/Support.astro';

const extensions = (await getCollection('extensions')).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const courses = (await getCollection('courses')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const tokenTools = (await getCollection('tokenTools')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const shorts = (await getCollection('shorts')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
---

<Layout title="hueanmy">
  <SectionNav />
  <main>
    <Hero />

    <ClaudeRoadmap />

    {
      courses.length > 0 && (
        <section id="courses">
          <h2>Claude Knowledge Base</h2>
          <div class="grid">
            {courses.map((c) => (
              <CourseCard id={c.id} {...c.data} />
            ))}
          </div>
        </section>
      )
    }

    {
      extensions.length > 0 && (
        <section id="extensions">
          <h2>SDLC pipeline</h2>
          <div class="grid">
            {extensions.map((e) => (
              <ExtensionCard {...e.data} />
            ))}
          </div>
        </section>
      )
    }

    {
      tokenTools.length > 0 && (
        <section id="token-optimization">
          <h2>Token Optimization</h2>
          <div class="grid">
            {tokenTools.map((t) => (
              <ProjectCard {...t.data} />
            ))}
          </div>
        </section>
      )
    }

    {
      shorts.length > 0 && (
        <section id="ai-shorts">
          <h2>AI video generators</h2>
          <div class="grid">
            {shorts.map((s) => (
              <ProjectCard {...s.data} />
            ))}
          </div>
        </section>
      )
    }

    {
      projects.length > 0 && (
        <section id="projects">
          <h2>Projects</h2>
          <div class="grid">
            {projects.map((p) => (
              <ProjectCard {...p.data} />
            ))}
          </div>
        </section>
      )
    }

    <Support />
  </main>
</Layout>
