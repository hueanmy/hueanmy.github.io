---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ClaudeRoadmap from '../components/ClaudeRoadmap.astro';
import CCAFRoadmap from '../components/CCAFRoadmap.astro';
import ExtensionCard from '../components/ExtensionCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CourseCard from '../components/CourseCard.astro';
import Support from '../components/Support.astro';
import AIDLCSuite from '../components/AIDLCSuite.astro';

const extensions = (await getCollection('extensions')).sort((a, b) => a.data.order - b.data.order);
const projects   = (await getCollection('projects')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
const courses    = (await getCollection('courses')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
const tokenTools = (await getCollection('tokenTools')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
const shorts     = (await getCollection('shorts')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
---

<Layout title="Meii">
  <Hero />

  <!-- ① Writing -->
  <div class="tab-panel" data-panel="writing">
    <p class="section-title">Writing</p>
    <div class="card-grid">
      <article class="card">
        <div class="card-thumb-placeholder"></div>
        <div class="card-body">
          <div class="card-meta"><span>Coming soon</span></div>
          <h2 class="card-title">Notes, tutorials, and things I've learned</h2>
          <p class="card-desc">Upcoming posts on AI, Claude, developer tooling, and open source.</p>
        </div>
      </article>
    </div>
  </div>

  <!-- ② Free Resources -->
  <div class="tab-panel" data-panel="resources" hidden>
    <p class="section-title">Free Resources</p>
    <section><ClaudeRoadmap /></section>
    <section><CCAFRoadmap /></section>
    <section>
      <a class="external-banner" href="https://anthropic.skilljar.com/" target="_blank" rel="noopener">
        <div class="banner-body">
          <span class="banner-badge">Free · Anthropic Academy</span>
          <h3>Anthropic Free Courses</h3>
          <p>Official free courses from Anthropic — Claude fundamentals, prompt engineering, API, MCP, Claude Code, and agent building.</p>
        </div>
        <span class="banner-cta">anthropic.skilljar.com ↗</span>
      </a>
    </section>
    {courses.length > 0 && (
      <section>
        <h2>Claude Knowledge Base</h2>
        <div class="card-grid">
          {courses.map(c => <CourseCard id={c.id} {...c.data} />)}
        </div>
      </section>
    )}
  </div>

  <!-- ③ Projects -->
  <div class="tab-panel" data-panel="projects" hidden>
    <p class="section-title">Projects</p>

    <!-- Category sub-tabs -->
    <div class="cat-nav">
      <button class="cat-btn active" data-cat="aidlc">AIDLC Suite</button>
      {extensions.length > 0 && <button class="cat-btn" data-cat="sdlc">SDLC Pipeline</button>}
      {tokenTools.length > 0 && <button class="cat-btn" data-cat="tokens">Token Optimization</button>}
      {shorts.length > 0 && <button class="cat-btn" data-cat="video">AI Video</button>}
      {projects.length > 0 && <button class="cat-btn" data-cat="oss">Open Source</button>}
      <button class="cat-btn" data-cat="setup">WFH Setup</button>
    </div>

    <!-- AIDLC Suite — first / default -->
    <section class="cat-panel" data-cat-panel="aidlc">
      <AIDLCSuite />
    </section>

    <!-- SDLC Pipeline -->
    {extensions.length > 0 && (
      <section class="cat-panel" data-cat-panel="sdlc" hidden>
        <div class="card-grid">{extensions.map(e => <ExtensionCard {...e.data} />)}</div>
      </section>
    )}

    <!-- Token Optimization -->
    {tokenTools.length > 0 && (
      <section class="cat-panel" data-cat-panel="tokens" hidden>
        <div class="card-grid">{tokenTools.map(t => <ProjectCard {...t.data} />)}</div>
      </section>
    )}

    <!-- AI Video Generators -->
    {shorts.length > 0 && (
      <section class="cat-panel" data-cat-panel="video" hidden>
        <div class="card-grid">{shorts.map(s => <ProjectCard {...s.data} />)}</div>
      </section>
    )}

    <!-- Open Source -->
    {projects.length > 0 && (
      <section class="cat-panel" data-cat-panel="oss" hidden>
        <div class="card-grid">{projects.map(p => <ProjectCard {...p.data} />)}</div>
      </section>
    )}

    <!-- WFH Setup -->
    <section class="cat-panel" data-cat-panel="setup" hidden>
      <div class="card-grid">
        <a class="card" href="/setup" style="text-decoration:none;color:inherit">
          <div class="card-thumb-placeholder"></div>
          <div class="card-body">
            <h2 class="card-title">My Desk Setup</h2>
            <p class="card-desc">Hardware, peripherals, and the small things that make my day better.</p>
            <div style="margin-top:auto;padding-top:0.5rem"><span class="tag">coming soon</span></div>
          </div>
        </a>
      </div>
    </section>
  </div>

  <!-- ④ About Me -->
  <div class="tab-panel" data-panel="about" hidden>
    <p class="section-title">About Me</p>
    <section>
      <div class="about-body">
        <p>Hi, I'm <strong>Meii</strong> — a developer with a background in mobile, desktop, and web. I'm currently learning AI and applying Claude to developer tooling, AIDLC workflows, and QA automation.</p>
        <p>I believe good tools make developers more effective — so I spend a lot of time building open source and sharing what I learn.</p>
        <p>
          <a href="https://github.com/hueanmy">GitHub</a> ·
          <a href="https://www.youtube.com/@studyingwithmeii">YouTube</a> ·
          <a href="https://www.tiktok.com/@studyingwithmeii">TikTok</a> ·
          <a href="mailto:ltmai93@gmail.com">Email</a>
        </p>
      </div>
    </section>
    <Support />
  </div>
</Layout>

<style>
  /* Category sub-nav inside Projects */
  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin-bottom: 1.75rem;
    padding-bottom: 1.25rem;
    border-bottom: 1px solid var(--border);
  }
  .cat-btn {
    background: none;
    border: 1px solid var(--border);
    font-family: var(--font-sans);
    font-size: 0.78rem;
    font-weight: 500;
    color: var(--fg-muted);
    padding: 0.3rem 0.85rem;
    border-radius: 999px;
    cursor: pointer;
    transition: color 120ms, background 120ms, border-color 120ms;
    white-space: nowrap;
  }
  .cat-btn:hover   { color: var(--fg); border-color: var(--fg-dim); }
  .cat-btn.active  { background: var(--fg); color: var(--bg); border-color: var(--fg); font-weight: 600; }

  .cat-panel { animation: fade-in 130ms ease both; }
</style>

<script>
  function initCatNav() {
    const projectsPanel = document.querySelector('[data-panel="projects"]');
    if (!projectsPanel) return;

    const btns   = projectsPanel.querySelectorAll('.cat-btn');
    const panels = projectsPanel.querySelectorAll('.cat-panel');

    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = btn.dataset.cat;
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        panels.forEach(p => {
          if (p.dataset.catPanel === cat) {
            p.removeAttribute('hidden');
          } else {
            p.setAttribute('hidden', '');
          }
        });
      });
    });
  }
  // Run on page load and after tab switches
  document.addEventListener('DOMContentLoaded', initCatNav);
</script>
