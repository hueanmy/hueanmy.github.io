---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ClaudeRoadmap from '../components/ClaudeRoadmap.astro';
import SectionNav from '../components/SectionNav.astro';
import ExtensionCard from '../components/ExtensionCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CourseCard from '../components/CourseCard.astro';
import Support from '../components/Support.astro';

const extensions = (await getCollection('extensions')).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const courses = (await getCollection('courses')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const tokenTools = (await getCollection('tokenTools')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const shorts = (await getCollection('shorts')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
---

<Layout title="Meii">
  <SectionNav />
  <main>
    <Hero />

    <div id="learn" class="section-group">
      <div class="group-head">
        <span class="group-num">①</span>
        <h2 class="group-title">Learn</h2>
        <span class="group-rule"></span>
      </div>

      <ClaudeRoadmap />

      <section id="anthropic-courses">
        <a
          class="external-banner"
          href="https://anthropic.skilljar.com/"
          target="_blank"
          rel="noopener"
        >
          <div class="banner-body">
            <span class="banner-badge">Free · Anthropic Academy</span>
            <h3>Anthropic Free Courses</h3>
            <p>
              Khoá học miễn phí chính thức từ Anthropic — Claude fundamentals,
              prompt engineering, API, MCP, Claude Code và agent building.
            </p>
          </div>
          <span class="banner-cta">anthropic.skilljar.com ↗</span>
        </a>
      </section>

      {
        courses.length > 0 && (
          <section id="courses">
            <h2>Claude Knowledge Base</h2>
            <div class="grid">
              {courses.map((c) => (
                <CourseCard id={c.id} {...c.data} />
              ))}
            </div>
          </section>
        )
      }
    </div>

    <div id="build" class="section-group">
      <div class="group-head">
        <span class="group-num">②</span>
        <h2 class="group-title">Open Source</h2>
        <span class="group-rule"></span>
      </div>

      {
        extensions.length > 0 && (
          <section id="extensions">
            <h2>SDLC pipeline</h2>
            <div class="grid">
              {extensions.map((e) => (
                <ExtensionCard {...e.data} />
              ))}
            </div>
          </section>
        )
      }

      {
        tokenTools.length > 0 && (
          <section id="token-optimization">
            <h2>Token Optimization</h2>
            <div class="grid">
              {tokenTools.map((t) => (
                <ProjectCard {...t.data} />
              ))}
            </div>
          </section>
        )
      }

      {
        shorts.length > 0 && (
          <section id="ai-shorts">
            <h2>AI video generators</h2>
            <div class="grid">
              {shorts.map((s) => (
                <ProjectCard {...s.data} />
              ))}
            </div>
          </section>
        )
      }

      {
        projects.length > 0 && (
          <section id="projects">
            <h2>Projects</h2>
            <div class="grid">
              {projects.map((p) => (
                <ProjectCard {...p.data} />
              ))}
            </div>
          </section>
        )
      }
    </div>

    <div id="shop" class="section-group">
      <div class="group-head">
        <span class="group-num">③</span>
        <h2 class="group-title">WFH Setup</h2>
        <span class="group-rule"></span>
      </div>

      <section id="shop-items">
        <div class="grid">
          <a class="card shop-card" href="/setup">
            <h3>My Desk Setup</h3>
            <p>Hardware, peripherals, and the small things that make my day better.</p>
            <div class="meta">
              <span class="tag">coming soon</span>
            </div>
          </a>
        </div>
      </section>
    </div>

    <div id="support" class="section-group">
      <div class="group-head">
        <span class="group-num">④</span>
        <h2 class="group-title">Support</h2>
        <span class="group-rule"></span>
      </div>

      <Support />
    </div>
  </main>
</Layout>

<style is:global>
  .section-group {
    margin-bottom: 4.5rem;
  }

  .section-group > section {
    margin-bottom: 2.75rem;
  }

  .section-group > section:last-child {
    margin-bottom: 0;
  }

  .group-head {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    margin-bottom: 2rem;
  }

  .group-num {
    font-family: var(--font-mono);
    font-size: 1.05rem;
    color: var(--accent);
    line-height: 1;
  }

  .group-title {
    font-size: 1.35rem;
    font-weight: 700;
    letter-spacing: -0.01em;
    color: var(--fg);
    text-transform: none;
    background: var(--gradient-accent);
    background-clip: text;
    -webkit-background-clip: text;
    color: transparent;
    -webkit-text-fill-color: transparent;
    border-bottom: 0;
    padding-bottom: 0;
    margin-bottom: 0;
  }

  .group-rule {
    flex: 1;
    height: 1px;
    background: var(--border);
  }

  .shop-card {
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }

  .shop-card:hover {
    color: inherit;
  }

  /* SUPPORT group: the inner Support section already has its own h2.
     Keep it, but the group head ("Support") sits above. */
  #support > section { margin-bottom: 0; }

  #anthropic-courses {
    margin-top: -0.75rem;
  }

  .external-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1.1rem 1.4rem;
    background: linear-gradient(180deg, var(--bg-raised), var(--card-tint));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 200ms ease,
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .external-banner:hover {
    border-color: rgba(167, 139, 250, 0.5);
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgba(167, 139, 250, 0.15),
      0 8px 30px rgba(94, 234, 212, 0.06),
      0 2px 10px rgba(167, 139, 250, 0.08);
  }

  .banner-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    flex: 1;
  }

  .banner-badge {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 2px 8px;
    border-radius: 20px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .external-banner h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--fg);
  }

  .external-banner p {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--fg-dim);
    margin: 0;
  }

  .banner-cta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    white-space: nowrap;
    transition: color 150ms ease;
  }

  .external-banner:hover .banner-cta {
    color: var(--fg);
  }
</style>
