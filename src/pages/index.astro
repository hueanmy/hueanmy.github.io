---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ClaudeRoadmap from '../components/ClaudeRoadmap.astro';
import CCAFRoadmap from '../components/CCAFRoadmap.astro';
import ExtensionCard from '../components/ExtensionCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CourseCard from '../components/CourseCard.astro';
import Support from '../components/Support.astro';
import AIDLCSuite from '../components/AIDLCSuite.astro';

const extensions = (await getCollection('extensions')).sort((a, b) => a.data.order - b.data.order);
const projects   = (await getCollection('projects')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
const courses    = (await getCollection('courses')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
const tokenTools = (await getCollection('tokenTools')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
const shorts     = (await getCollection('shorts')).sort((a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order);
---

<Layout title="Meii">
  <Hero />

  <!-- ① Writing -->
  <div class="tab-panel" data-panel="writing">
    <p class="section-title">
      <span class="lang-en">Writing</span>
      <span class="lang-vi">Bài viết</span>
    </p>

    <div class="writing-toolbar">
      <input
        id="writing-search"
        class="writing-search"
        type="search"
        placeholder="Search..."
        aria-label="Search articles"
      />
      <nav class="cat-nav writing-cat-nav">
        <button class="cat-btn active" data-wcat="all">
          <span class="cat-dot"></span>
          <span class="lang-en">All</span><span class="lang-vi">Tất cả</span>
        </button>
        <button class="cat-btn" data-wcat="claude-code">
          <span class="cat-dot"></span>Claude Code
        </button>
        <button class="cat-btn" data-wcat="prompt">
          <span class="cat-dot"></span>
          <span class="lang-en">Prompt Engineering</span><span class="lang-vi">Prompt Engineering</span>
        </button>
      </nav>
    </div>

    <div class="card-grid" id="writing-grid">
      {courses.map(c => (
        <div
          class="writing-item"
          data-tags={JSON.stringify(c.data.tags ?? [])}
          data-title={c.data.title.toLowerCase()}
          data-desc={(c.data.description ?? '').toLowerCase()}
        >
          <CourseCard id={c.id} {...c.data} />
        </div>
      ))}
    </div>
    <p class="writing-empty" hidden>
      <span class="lang-en">No results found.</span>
      <span class="lang-vi">Không tìm thấy kết quả.</span>
    </p>
  </div>

  <!-- ② Free Resources -->
  <div class="tab-panel" data-panel="resources" hidden>
    <p class="section-title">
      <span class="lang-en">Free Resources</span>
      <span class="lang-vi">Tài nguyên miễn phí</span>
    </p>
    <section><ClaudeRoadmap /></section>
    <section><CCAFRoadmap /></section>
    <section>
      <a class="external-banner" href="https://anthropic.skilljar.com/" target="_blank" rel="noopener">
        <div class="banner-body">
          <span class="banner-badge">
            <span class="lang-en">Free · Anthropic Academy</span>
            <span class="lang-vi">Miễn phí · Anthropic Academy</span>
          </span>
          <h3>
            <span class="lang-en">Anthropic Free Courses</span>
            <span class="lang-vi">Khóa học miễn phí từ Anthropic</span>
          </h3>
          <p>
            <span class="lang-en">Official free courses from Anthropic — Claude fundamentals, prompt engineering, API, MCP, Claude Code, and agent building.</span>
            <span class="lang-vi">Khóa học miễn phí chính thức từ Anthropic — nền tảng Claude, prompt engineering, API, MCP, Claude Code và xây dựng agent.</span>
          </p>
        </div>
        <span class="banner-cta">anthropic.skilljar.com ↗</span>
      </a>
    </section>
  </div>

  <!-- ③ Projects -->
  <div class="tab-panel" data-panel="projects" hidden>
    <p class="section-title">
      <span class="lang-en">Projects</span>
      <span class="lang-vi">Dự án</span>
    </p>
    <nav class="cat-nav proj-cat-nav">
      <button class="cat-btn active" data-cat="aidlc">
        <span class="cat-dot"></span>AIDLC Suite <span class="cat-count">4</span>
      </button>
      {tokenTools.length > 0 && (
        <button class="cat-btn" data-cat="tokens">
          <span class="cat-dot"></span>
          <span class="lang-en">Token Optimization</span>
          <span class="lang-vi">Tối ưu Token</span>
          <span class="cat-count">{tokenTools.length}</span>
        </button>
      )}
      {shorts.length > 0 && (
        <button class="cat-btn" data-cat="video">
          <span class="cat-dot"></span>AI Video <span class="cat-count">{shorts.length}</span>
        </button>
      )}
    </nav>
    <section class="cat-panel" data-cat-panel="aidlc">
      <AIDLCSuite />
    </section>
    {tokenTools.length > 0 && (
      <section class="cat-panel" data-cat-panel="tokens" hidden>
        <div class="card-grid">{tokenTools.map(t => <ProjectCard {...t.data} />)}</div>
      </section>
    )}
    {shorts.length > 0 && (
      <section class="cat-panel" data-cat-panel="video" hidden>
        <div class="card-grid">{shorts.map(s => <ProjectCard {...s.data} />)}</div>
      </section>
    )}
  </div>

  <!-- ④ About Me -->
  <div class="tab-panel" data-panel="about" hidden>
    <p class="section-title">
      <span class="lang-en">About Me</span>
      <span class="lang-vi">Về mình</span>
    </p>
    <section>
      <div class="about-body">
        <p>
          <span class="lang-en">I believe good tools make developers more effective — so I spend a lot of time building open source and sharing what I learn.</span>
          <span class="lang-vi">Tôi tin rằng công cụ tốt giúp developer hiệu quả hơn — vì vậy tôi dành nhiều thời gian xây dựng open source và chia sẻ những gì học được.</span>
        </p>
        <p>
          <a href="https://github.com/hueanmy">GitHub</a> ·
          <a href="https://www.youtube.com/@studyingwithmeii">YouTube</a> ·
          <a href="https://www.tiktok.com/@studyingwithmeii">TikTok</a> ·
          <a href="mailto:ltmai93@gmail.com">Email</a>
        </p>
      </div>
    </section>
    <Support />
  </div>
</Layout>

<style>
  .writing-toolbar {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .writing-search {
    width: 100%;
    max-width: 320px;
    padding: 0.45rem 0.75rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    background: var(--bg-card);
    border: 1px solid var(--border);
    border-radius: 6px;
    color: var(--fg);
    outline: none;
    transition: border-color 120ms;
  }
  .writing-search:focus { border-color: var(--accent); }
  .writing-search::placeholder { color: var(--fg-muted); }

  .writing-empty {
    font-family: var(--font-mono);
    font-size: 0.8rem;
    color: var(--fg-muted);
    padding: 2rem 0;
  }

  .cat-nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0;
    border-bottom: 1px solid var(--border);
  }
  .writing-cat-nav { margin-bottom: 0; }
  .proj-cat-nav { margin-bottom: 1.75rem; }

  .cat-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    background: none;
    border: none;
    border-bottom: 2px solid transparent;
    margin-bottom: -1px;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    font-weight: 500;
    letter-spacing: 0.04em;
    color: var(--fg-muted);
    padding: 0.55rem 1rem 0.55rem 0;
    margin-right: 1.5rem;
    cursor: pointer;
    transition: color 120ms, border-color 120ms;
    white-space: nowrap;
  }
  .cat-btn:hover { color: var(--fg); }
  .cat-btn.active { color: var(--accent); border-bottom-color: var(--accent); }

  .cat-dot {
    width: 6px; height: 6px;
    border-radius: 50%;
    background: currentColor;
    opacity: 0.5;
    flex-shrink: 0;
  }
  .cat-btn.active .cat-dot { opacity: 1; }
  .cat-count { font-size: 0.62rem; opacity: 0.6; }

  .cat-panel { animation: fade-in 130ms ease both; }
  .writing-item { display: contents; }
</style>

<script>
  function initProjectsCatNav() {
    const panel = document.querySelector('[data-panel="projects"]');
    if (!panel) return;
    const btns   = panel.querySelectorAll('.cat-btn');
    const panels = panel.querySelectorAll('.cat-panel');
    btns.forEach(btn => {
      btn.addEventListener('click', () => {
        const cat = (btn as HTMLElement).dataset.cat;
        btns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        panels.forEach(p => {
          (p as HTMLElement).dataset.catPanel === cat
            ? p.removeAttribute('hidden')
            : p.setAttribute('hidden', '');
        });
      });
    });
  }

  function initWriting() {
    const searchEl = document.getElementById('writing-search') as HTMLInputElement | null;
    const grid     = document.getElementById('writing-grid');
    const empty    = document.querySelector('.writing-empty') as HTMLElement | null;
    const catBtns  = document.querySelectorAll('.writing-cat-nav .cat-btn');
    if (!searchEl || !grid || !empty) return;

    const catFilters: Record<string, (tags: string[]) => boolean> = {
      'all':        () => true,
      'claude-code': (tags) => tags.some(t => t.toLowerCase().includes('claude code')),
      'prompt':     (tags) => tags.some(t => t.toLowerCase().includes('prompt') || t.toLowerCase().includes('eval')),
    };

    let activeCat = 'all';
    let query     = '';

    function applyFilter() {
      const items = grid!.querySelectorAll<HTMLElement>('.writing-item');
      let visible = 0;
      items.forEach(item => {
        const tags  = JSON.parse(item.dataset.tags ?? '[]') as string[];
        const title = item.dataset.title ?? '';
        const desc  = item.dataset.desc  ?? '';
        const matchCat  = catFilters[activeCat]?.(tags) ?? true;
        const matchText = !query || title.includes(query) || desc.includes(query) ||
                          tags.some(t => t.toLowerCase().includes(query));
        const show = matchCat && matchText;
        item.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      empty!.hidden = visible > 0;
    }

    searchEl.addEventListener('input', () => {
      query = searchEl.value.toLowerCase().trim();
      applyFilter();
    });

    catBtns.forEach(btn => {
      btn.addEventListener('click', () => {
        activeCat = (btn as HTMLElement).dataset.wcat ?? 'all';
        catBtns.forEach(b => b.classList.remove('active'));
        btn.classList.add('active');
        applyFilter();
      });
    });
  }

  document.addEventListener('DOMContentLoaded', () => {
    initProjectsCatNav();
    initWriting();
  });
</script>
