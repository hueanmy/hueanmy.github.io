---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import ClaudeRoadmap from '../components/ClaudeRoadmap.astro';
import CCAFRoadmap from '../components/CCAFRoadmap.astro';
import ExtensionCard from '../components/ExtensionCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CourseCard from '../components/CourseCard.astro';
import Support from '../components/Support.astro';

const extensions = (await getCollection('extensions')).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = (await getCollection('projects')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order
);
const courses = (await getCollection('courses')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order
);
const tokenTools = (await getCollection('tokenTools')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order
);
const shorts = (await getCollection('shorts')).sort(
  (a, b) => Number(b.data.featured) - Number(a.data.featured) || a.data.order - b.data.order
);
---

<Layout title="Meii" activeTab="writing">
  <Hero />

  <!-- ① Writing (default) -->
  <div class="tab-panel" data-panel="writing">
    <p class="section-title">Writing</p>
    <div class="card-grid">
      <article class="card">
        <div class="card-thumb-placeholder"></div>
        <div class="card-body">
          <div class="card-meta">
            <span>Coming soon</span>
          </div>
          <h2 class="card-title">Notes, tutorials và những thứ tôi học được</h2>
          <p class="card-desc">Sẽ có bài viết về AI, Claude, developer tooling và open source.</p>
        </div>
      </article>
    </div>
  </div>

  <!-- ② Free Resources -->
  <div class="tab-panel" data-panel="resources" hidden>
    <p class="section-title">Free Resources</p>

    <section>
      <ClaudeRoadmap />
    </section>

    <section>
      <CCAFRoadmap />
    </section>

    <section>
      <a class="external-banner" href="https://anthropic.skilljar.com/" target="_blank" rel="noopener">
        <div class="banner-body">
          <span class="banner-badge">Free · Anthropic Academy</span>
          <h3>Anthropic Free Courses</h3>
          <p>Khoá học miễn phí chính thức từ Anthropic — Claude fundamentals, prompt engineering, API, MCP, Claude Code và agent building.</p>
        </div>
        <span class="banner-cta">anthropic.skilljar.com ↗</span>
      </a>
    </section>

    {courses.length > 0 && (
      <section>
        <h2>Claude Knowledge Base</h2>
        <div class="card-grid">
          {courses.map(c => <CourseCard id={c.id} {...c.data} />)}
        </div>
      </section>
    )}
  </div>

  <!-- ③ Projects -->
  <div class="tab-panel" data-panel="projects" hidden>
    <p class="section-title">Projects</p>

    {extensions.length > 0 && (
      <section>
        <h2>SDLC Pipeline</h2>
        <div class="card-grid">
          {extensions.map(e => <ExtensionCard {...e.data} />)}
        </div>
      </section>
    )}

    {tokenTools.length > 0 && (
      <section>
        <h2>Token Optimization</h2>
        <div class="card-grid">
          {tokenTools.map(t => <ProjectCard {...t.data} />)}
        </div>
      </section>
    )}

    {shorts.length > 0 && (
      <section>
        <h2>AI Video Generators</h2>
        <div class="card-grid">
          {shorts.map(s => <ProjectCard {...s.data} />)}
        </div>
      </section>
    )}

    {projects.length > 0 && (
      <section>
        <h2>Open Source</h2>
        <div class="card-grid">
          {projects.map(p => <ProjectCard {...p.data} />)}
        </div>
      </section>
    )}

    <section>
      <h2>WFH Setup</h2>
      <div class="card-grid">
        <a class="card" href="/setup" style="text-decoration:none;color:inherit">
          <div class="card-thumb-placeholder"></div>
          <div class="card-body">
            <h2 class="card-title">My Desk Setup</h2>
            <p class="card-desc">Hardware, peripherals, and the small things that make my day better.</p>
            <div style="margin-top:auto;padding-top:0.5rem">
              <span class="tag">coming soon</span>
            </div>
          </div>
        </a>
      </div>
    </section>
  </div>

  <!-- ④ About Me -->
  <div class="tab-panel" data-panel="about" hidden>
    <p class="section-title">About Me</p>

    <section>
      <div class="about-body">
        <p>Xin chào! Tôi là <strong>Meii</strong> — developer với background về mobile, desktop và web. Hiện tại tôi đang học AI và ứng dụng Claude vào developer tooling, AIDLC workflow và QA automation.</p>
        <p>Tôi tin rằng các công cụ tốt giúp developer làm việc hiệu quả hơn — nên tôi dành nhiều thời gian build open source và chia sẻ kiến thức.</p>
        <p>
          <a href="https://github.com/hueanmy">GitHub</a> ·
          <a href="https://www.youtube.com/@studyingwithmeii">YouTube</a> ·
          <a href="https://www.tiktok.com/@studyingwithmeii">TikTok</a> ·
          <a href="mailto:ltmai93@gmail.com">Email</a>
        </p>
      </div>
    </section>

    <Support />
  </div>
</Layout>

<style is:global>
  .about-body a {
    color: var(--accent);
  }
  .about-body a:hover {
    text-decoration: underline;
  }
  .about-body strong {
    color: var(--fg);
    font-weight: 600;
  }
</style>
