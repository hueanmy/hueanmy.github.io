---
import { getCollection } from 'astro:content';
import Layout from '../layouts/Layout.astro';
import Hero from '../components/Hero.astro';
import TabNav from '../components/TabNav.astro';
import ClaudeRoadmap from '../components/ClaudeRoadmap.astro';
import CCAFRoadmap from '../components/CCAFRoadmap.astro';
import ExtensionCard from '../components/ExtensionCard.astro';
import ProjectCard from '../components/ProjectCard.astro';
import CourseCard from '../components/CourseCard.astro';
import Support from '../components/Support.astro';

const extensions = (await getCollection('extensions')).sort(
  (a, b) => a.data.order - b.data.order
);
const projects = (await getCollection('projects')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const courses = (await getCollection('courses')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const tokenTools = (await getCollection('tokenTools')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
const shorts = (await getCollection('shorts')).sort(
  (a, b) =>
    Number(b.data.featured) - Number(a.data.featured) ||
    a.data.order - b.data.order
);
---

<Layout title="Meii">
  <main>
    <Hero />
    <TabNav />

    <!-- ① Tài liệu Free -->
    <div class="tab-panel" data-panel="resources" role="tabpanel" id="panel-resources" aria-labelledby="tab-resources">

      <ClaudeRoadmap />
      <CCAFRoadmap />

      <section id="anthropic-courses">
        <a
          class="external-banner"
          href="https://anthropic.skilljar.com/"
          target="_blank"
          rel="noopener"
        >
          <div class="banner-body">
            <span class="banner-badge">Free · Anthropic Academy</span>
            <h3>Anthropic Free Courses</h3>
            <p>
              Khoá học miễn phí chính thức từ Anthropic — Claude fundamentals,
              prompt engineering, API, MCP, Claude Code và agent building.
            </p>
          </div>
          <span class="banner-cta">anthropic.skilljar.com ↗</span>
        </a>
      </section>

      {
        courses.length > 0 && (
          <section id="courses">
            <h2>Claude Knowledge Base</h2>
            <div class="grid">
              {courses.map((c) => (
                <CourseCard id={c.id} {...c.data} />
              ))}
            </div>
          </section>
        )
      }
    </div>

    <!-- ② Projects -->
    <div class="tab-panel" data-panel="projects" role="tabpanel" id="panel-projects" aria-labelledby="tab-projects" hidden>

      {
        extensions.length > 0 && (
          <section id="extensions">
            <h2>SDLC Pipeline</h2>
            <div class="grid">
              {extensions.map((e) => (
                <ExtensionCard {...e.data} />
              ))}
            </div>
          </section>
        )
      }

      {
        tokenTools.length > 0 && (
          <section id="token-optimization">
            <h2>Token Optimization</h2>
            <div class="grid">
              {tokenTools.map((t) => (
                <ProjectCard {...t.data} />
              ))}
            </div>
          </section>
        )
      }

      {
        shorts.length > 0 && (
          <section id="ai-shorts">
            <h2>AI Video Generators</h2>
            <div class="grid">
              {shorts.map((s) => (
                <ProjectCard {...s.data} />
              ))}
            </div>
          </section>
        )
      }

      {
        projects.length > 0 && (
          <section id="projects">
            <h2>Open Source</h2>
            <div class="grid">
              {projects.map((p) => (
                <ProjectCard {...p.data} />
              ))}
            </div>
          </section>
        )
      }

      <section id="wfh-setup">
        <h2>WFH Setup</h2>
        <div class="grid">
          <a class="card shop-card" href="/setup">
            <h3>My Desk Setup</h3>
            <p>Hardware, peripherals, and the small things that make my day better.</p>
            <div class="meta">
              <span class="tag">coming soon</span>
            </div>
          </a>
        </div>
      </section>
    </div>

    <!-- ③ Writing -->
    <div class="tab-panel" data-panel="writing" role="tabpanel" id="panel-writing" aria-labelledby="tab-writing" hidden>
      <section class="empty-state">
        <div class="empty-icon">✍️</div>
        <h3>Coming soon</h3>
        <p>Notes, tutorials, và những thứ tôi học được trên hành trình khám phá AI.</p>
      </section>
    </div>

    <!-- ④ About Me -->
    <div class="tab-panel" data-panel="about" role="tabpanel" id="panel-about" aria-labelledby="tab-about" hidden>
      <section class="about-section">
        <h2>About Me</h2>
        <div class="about-body">
          <p>
            Xin chào! Tôi là <strong>Meii</strong> — developer với background về
            mobile, desktop và web. Hiện tại tôi đang học AI và ứng dụng
            <strong>Claude</strong> vào developer tooling, AIDLC workflow và QA automation.
          </p>
          <p>
            Tôi tin rằng các công cụ tốt giúp developer làm việc hiệu quả hơn — nên tôi
            dành nhiều thời gian build open source và chia sẻ kiến thức.
          </p>
        </div>
      </section>

      <Support />
    </div>
  </main>
</Layout>

<style is:global>
  .tab-panel {
    animation: panel-in 180ms ease both;
  }

  @keyframes panel-in {
    from { opacity: 0; transform: translateY(6px); }
    to   { opacity: 1; transform: translateY(0); }
  }

  .tab-panel > section {
    margin-bottom: 3rem;
  }

  .tab-panel > section:last-child {
    margin-bottom: 0;
  }

  .shop-card {
    cursor: pointer;
    text-decoration: none;
    color: inherit;
  }
  .shop-card:hover { color: inherit; }

  .empty-state {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    padding: 5rem 2rem;
    text-align: center;
    gap: 0.75rem;
  }

  .empty-icon {
    font-size: 2.5rem;
    margin-bottom: 0.5rem;
  }

  .empty-state h3 {
    font-size: 1.15rem;
    font-weight: 600;
    color: var(--fg);
  }

  .empty-state p {
    font-size: 0.95rem;
    color: var(--fg-dim);
    max-width: 26rem;
    line-height: 1.6;
  }

  .about-section h2 {
    font-size: 0.78rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.14em;
    color: var(--fg-dim);
    margin-bottom: 1.25rem;
    padding-bottom: 0.75rem;
    border-bottom: 1px solid var(--border);
  }

  .about-body {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .about-body p {
    font-size: 1rem;
    color: var(--fg-dim);
    line-height: 1.7;
  }

  .about-body strong {
    color: var(--fg);
    font-weight: 600;
  }

  #anthropic-courses {
    margin-top: -0.75rem;
  }

  .external-banner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    flex-wrap: wrap;
    padding: 1.1rem 1.4rem;
    background: linear-gradient(180deg, var(--bg-raised), var(--card-tint));
    border: 1px solid var(--border);
    border-radius: var(--radius);
    color: inherit;
    text-decoration: none;
    transition:
      border-color 200ms ease,
      transform 200ms ease,
      box-shadow 200ms ease;
  }

  .external-banner:hover {
    border-color: rgba(167, 139, 250, 0.5);
    transform: translateY(-2px);
    box-shadow:
      0 0 0 1px rgba(167, 139, 250, 0.15),
      0 8px 30px rgba(94, 234, 212, 0.06),
      0 2px 10px rgba(167, 139, 250, 0.08);
  }

  .banner-body {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
    min-width: 0;
    flex: 1;
  }

  .banner-badge {
    display: inline-block;
    align-self: flex-start;
    font-family: var(--font-mono);
    font-size: 0.62rem;
    color: var(--accent);
    border: 1px solid var(--accent);
    padding: 2px 8px;
    border-radius: 20px;
    letter-spacing: 1.5px;
    text-transform: uppercase;
  }

  .external-banner h3 {
    font-size: 1rem;
    font-weight: 600;
    margin: 0;
    color: var(--fg);
  }

  .external-banner p {
    font-size: 0.84rem;
    line-height: 1.5;
    color: var(--fg-dim);
    margin: 0;
  }

  .banner-cta {
    font-family: var(--font-mono);
    font-size: 0.78rem;
    color: var(--accent);
    white-space: nowrap;
    transition: color 150ms ease;
  }

  .external-banner:hover .banner-cta {
    color: var(--fg);
  }
</style>
